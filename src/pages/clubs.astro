---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { APP_NAME } from '../lib/brand';

const clubFeatures = [
  {
    title: 'Leaderboard del club',
    desc: 'Ranking ELO de todos tus socios. Quién manda en la pista, visible para todo el club.',
    icon: '📊',
  },
  {
    title: 'Ligas internas',
    desc: 'Organiza competiciones por jornadas sin hojas de Excel. Round-robin automático.',
    icon: '🏆',
  },
  {
    title: 'Americanas exprés',
    desc: 'Torneos relámpago con inscripción y parejas aleatorias. Ideal para eventos del club.',
    icon: '⚡',
  },
  {
    title: 'Engagement post-partido',
    desc: 'Tus socios vuelven a la app después de jugar. Más retención que solo reservar pista.',
    icon: '🔥',
  },
  {
    title: 'Importación de partidos',
    desc: 'Tus jugadores importan partidos fácilmente con un enlace. Sin fricción, sin duplicar datos.',
    icon: '🔗',
  },
  {
    title: 'Dashboard B2B (próximamente)',
    desc: 'Métricas de actividad, quests patrocinadas por marcas y gestión de ligas desde web.',
    icon: '🖥️',
  },
];

const plans = [
  {
    name: 'Starter',
    price: 'Gratis',
    desc: 'Para clubs que empiezan a gamificar',
    features: ['Leaderboard del club', 'Hasta 2 ligas activas', 'Importación de partidos', 'Soporte email'],
  },
  {
    name: 'Club Pro',
    price: 'Próximamente',
    desc: 'Para clubs con alta actividad',
    features: [
      'Ligas ilimitadas',
      'Americanas exprés',
      'Branding personalizado',
      'Dashboard B2B',
      'Quests patrocinadas',
      'Soporte prioritario',
    ],
    highlight: true,
  },
  {
    name: 'Enterprise',
    price: 'Contactar',
    desc: 'Para cadenas y federaciones',
    features: [
      'Multi-sede',
      'API personalizada',
      'Integración POS',
      'Account manager',
      'SLA dedicado',
    ],
  },
];
---
<Layout
  title={`${APP_NAME} para Clubs — Gamifica tu club de pádel`}
  description="Leaderboards, ligas internas, americanas y engagement post-partido para tu club de pádel."
>
  <Navbar />
  <main class="pt-24">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-night-900 py-20">
      <div class="absolute inset-0 grid-pattern opacity-20"></div>
      <div class="relative mx-auto max-w-6xl px-5">
        <div class="mx-auto max-w-3xl text-center">
          <p class="section-label !text-brand-400">Para clubs de pádel</p>
          <h1 class="section-title-light mt-3">
            TU CLUB MERECE MÁS QUE RESERVAS
          </h1>
          <p class="mt-6 text-lg text-white/50">
            {APP_NAME} llena la comunidad. Leaderboards, ligas internas
            y engagement que hace que tus socios vuelvan después del partido.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href="mailto:hola@padelmvp.app" class="btn-primary">Solicitar demo</a>
            <a href="/" class="btn-secondary">Ver app jugadores</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-24">
      <div class="mx-auto max-w-6xl px-5">
        <div class="mx-auto max-w-2xl text-center">
          <p class="section-label">Funciones B2B</p>
          <h2 class="section-title mt-3">GESTIÓN DE COMUNIDAD, NO SOLO PISTAS</h2>
        </div>
        <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            clubFeatures.map((f) => (
              <div class="feature-card">
                <p class="text-2xl">{f.icon}</p>
                <h3 class="mt-3 font-display text-xl tracking-wide text-night-900">{f.title}</h3>
                <p class="mt-2 text-sm text-night-900/60">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Por qué Padel MVP -->
    <section class="bg-cream py-24">
      <div class="mx-auto max-w-4xl px-5 text-center">
        <p class="section-label">El valor diferencial</p>
        <h2 class="section-title mt-3">MÁS QUE RESERVAR, COMPETIR</h2>
        <p class="mt-6 text-night-900/60">
          Con {APP_NAME} conviertes cada partido en una experiencia gamificada:
          ligas activas, rankings en vivo y una comunidad que compite toda la temporada.
        </p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-night-900/10 bg-white p-6 shadow-card">
            <p class="text-xs font-bold uppercase tracking-widest text-night-900/40">Sin Padel MVP</p>
            <p class="mt-2 font-display text-xl text-night-900">Reservas & pistas</p>
            <p class="mt-2 text-sm text-night-900/50">El partido termina en la pista</p>
          </div>
          <div class="rounded-2xl border-2 border-brand-600/30 bg-white p-6 shadow-glow-sm">
            <p class="text-xs font-bold uppercase tracking-widest text-brand-600">Con Padel MVP</p>
            <p class="mt-2 font-display text-xl text-night-900">Comunidad & competición</p>
            <p class="mt-2 text-sm text-night-900/50">Ligas, rankings, 3er tiempo, retención</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="py-24">
      <div class="mx-auto max-w-6xl px-5">
        <div class="mx-auto max-w-2xl text-center">
          <p class="section-label">Planes</p>
          <h2 class="section-title mt-3">ELIGE TU PLAN</h2>
        </div>
        <div class="mt-16 grid gap-6 lg:grid-cols-3">
          {
            plans.map((plan) => (
              <div
                class:list={[
                  'rounded-2xl border p-8',
                  plan.highlight
                    ? 'border-brand-600 bg-brand-600/5 shadow-glow-sm'
                    : 'border-night-900/10 bg-white shadow-card',
                ]}
              >
                {plan.highlight && (
                  <span class="mb-4 inline-block rounded-full bg-brand-600 px-3 py-1 text-xs font-bold text-white">
                    Recomendado
                  </span>
                )}
                <h3 class="font-display text-2xl tracking-wide text-night-900">{plan.name}</h3>
                <p class="mt-1 text-3xl font-bold text-brand-600">{plan.price}</p>
                <p class="mt-2 text-sm text-night-900/50">{plan.desc}</p>
                <ul class="mt-6 space-y-2.5">
                  {
                    plan.features.map((f) => (
                      <li class="flex items-center gap-2 text-sm text-night-900/70">
                        <span class="text-brand-600">✓</span> {f}
                      </li>
                    ))
                  }
                </ul>
                <a
                  href="mailto:hola@padelmvp.app"
                  class:list={[
                    'mt-8 block rounded-full py-3 text-center text-sm font-semibold transition',
                    plan.highlight
                      ? 'bg-brand-600 text-white hover:bg-brand-500'
                      : 'border border-night-900/10 hover:border-brand-600/30',
                  ]}
                >
                  Contactar
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-brand-600 py-20">
      <div class="mx-auto max-w-3xl px-5 text-center">
        <h2 class="font-display text-4xl tracking-wide text-white sm:text-5xl">
          ¿LISTO PARA GAMIFICAR TU CLUB?
        </h2>
        <p class="mt-4 text-white/70">Escríbenos y te enseñamos cómo funciona en 15 minutos.</p>
        <a
          href="mailto:hola@padelmvp.app"
          class="mt-8 inline-block rounded-full bg-night-900 px-8 py-3.5 text-sm font-semibold text-white transition hover:bg-night-800"
        >
          hola@padelmvp.app
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
