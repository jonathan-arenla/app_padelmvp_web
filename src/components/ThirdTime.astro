---
const steps = [
  {
    num: '01',
    title: 'Vota al MVP',
    desc: 'El grupo elige al jugador estrella del partido. El MVP sube de visibilidad en el muro del club.',
    icon: '👑',
  },
  {
    num: '02',
    title: 'Reparte insignias',
    desc: 'El Muro, El Cañonero, Fair Play… Reconoce lo que cada compi hizo bien en la pista.',
    icon: '🏅',
  },
  {
    num: '03',
    title: 'Publica en el muro',
    desc: 'Comparte el resultado, tu carta actualizada o un salseo. Plantillas estilo Stories incluidas.',
    icon: '📱',
  },
];
---
<section id="tercer-tiempo" class="relative overflow-hidden bg-night-900 py-24">
  <div class="absolute inset-0 grid-pattern opacity-20"></div>
  <div
    class="absolute left-1/2 top-0 h-[300px] w-[600px] -translate-x-1/2 rounded-full bg-brand-600/15 blur-[100px]"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-5">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <div>
        <p class="section-label !text-brand-400">El diferenciador</p>
        <h2 class="section-title-light mt-3">EL 3ER TIEMPO</h2>
        <p class="mt-6 text-lg leading-relaxed text-white/50">
          El pitido final no es el fin — es el comienzo. En Padel MVP <strong class="text-white">empieza
          la diversión</strong>: votaciones, reconocimiento y salseo con tus compis del club.
        </p>

        <div class="mt-10 space-y-6">
          {
            steps.map((step) => (
              <div class="flex gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-600/20 text-xl">
                  {step.icon}
                </div>
                <div>
                  <p class="text-xs font-bold text-brand-400">{step.num}</p>
                  <h3 class="font-display text-xl tracking-wide text-white">{step.title}</h3>
                  <p class="mt-1 text-sm text-white/50">{step.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Phone mockup -->
      <div class="relative mx-auto w-full max-w-xs">
        <div class="rounded-[2.5rem] border-4 border-night-600 bg-night-800 p-3 shadow-card-dark">
          <div class="overflow-hidden rounded-[2rem] bg-night-900">
            <div class="bg-brand-600 px-4 py-3 text-center">
              <p class="text-xs font-bold text-white/80">3ER TIEMPO</p>
              <p class="font-display text-lg tracking-wide text-white">¿Quién fue el MVP?</p>
            </div>
            <div class="space-y-2 p-4">
              {
                ['Carlos M.', 'Ana R.', 'Pedro L.', 'Laura S.'].map((name, i) => (
                  <div
                    class:list={[
                      'flex items-center gap-3 rounded-xl px-3 py-2.5 transition',
                      i === 0 ? 'bg-brand-600/20 ring-1 ring-brand-600/40' : 'bg-white/5',
                    ]}
                  >
                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600/30 text-sm">
                      {name[0]}
                    </div>
                    <span class="text-sm text-white">{name}</span>
                    {i === 0 && <span class="ml-auto text-sm">👑</span>}
                  </div>
                ))
              }
            </div>
            <div class="border-t border-white/10 p-4">
              <div class="rounded-full bg-brand-600 py-2.5 text-center text-sm font-bold text-white">
                Confirmar MVP
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
