---
const feed = [
  {
    user: 'Alex P.',
    handle: '@alex_padel',
    rank: 'ORO',
    rankIcon: '🥇',
    time: 'hace 2h',
    text: 'Qué partido el de hoy. 4 match points salvados y al final remontamos 6-4 en el tercero. El nivel en el club está subiendo 🔥',
    likes: 47,
    comments: 12,
    badge: '🛡️ El Muro',
    badgeColor: 'from-red-700 to-orange-600',
    image: true,
  },
  {
    user: 'Sara M.',
    handle: '@sara_padel',
    rank: 'PLATA',
    rankIcon: '🥈',
    time: 'hace 5h',
    text: 'Primera vez votada MVP del partido! No me lo esperaba pero gracias chicos 🙏 El tercer tiempo con los 4 fue épico como siempre.',
    likes: 89,
    comments: 23,
    badge: '👑 MVP',
    badgeColor: 'from-yellow-500 to-amber-400',
    image: false,
  },
  {
    user: 'Jon A.',
    handle: '@jon_padel',
    rank: 'DIAMANTE',
    rankIcon: '💎',
    time: 'hace 1d',
    text: 'Liga de mayo finalizada. Campeones! 5-1 en la jornada decisiva. Ya estoy en el Top 3 del ranking del club 🏆',
    likes: 134,
    comments: 38,
    badge: '💣 El Cañonero',
    badgeColor: 'from-orange-700 to-amber-500',
    image: false,
  },
];

const features = [
  {
    icon: '📸',
    title: 'Publica tus partidos',
    desc: 'Comparte el resultado, las stats, el resumen del partido y las fotos con tu comunidad.',
  },
  {
    icon: '👥',
    title: 'Sigue a jugadores',
    desc: 'Sigue a tus rivales, amigos y referentes del club. Mira cómo evolucionan.',
  },
  {
    icon: '🏅',
    title: 'Insignias públicas',
    desc: 'Cada logro en la pista queda reflejado en tu perfil. La comunidad lo ve.',
  },
  {
    icon: '💬',
    title: 'Chat integrado',
    desc: 'Grupos de partido, chats del club, coordinación del 3er tiempo. Todo en un sitio.',
  },
];
---

<section id="comunidad" class="relative py-28 overflow-hidden bg-surface">
  <div class="absolute inset-0 grid-pattern-light opacity-60"></div>

  <div class="container-x relative">
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-16 items-center">
      <!-- Feed mockup -->
      <div class="relative">
        <!-- Social feed cards -->
        <div class="space-y-4">
          {feed.map((post, i) => (
            <div class={`card p-5 ${i === 0 ? 'shadow-xl ring-brand-200/60' : ''}`}
                 style={i === 1 ? 'transform: translateX(24px)' : i === 2 ? 'transform: translateX(12px)' : ''}>
              <!-- User row -->
              <div class="flex items-center gap-3 mb-3">
                <div class="h-10 w-10 rounded-full bg-gradient-to-br from-brand-500 to-electric-600 grid place-items-center text-white font-bold text-sm shrink-0">
                  {post.user[0]}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <p class="font-semibold text-sm text-ink-900">{post.user}</p>
                    <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-surface text-ink-500">
                      {post.rankIcon} {post.rank}
                    </span>
                  </div>
                  <p class="text-xs text-ink-400">{post.handle} · {post.time}</p>
                </div>
                <!-- Badge -->
                <div class={`flex items-center gap-1.5 bg-gradient-to-r ${post.badgeColor} text-white text-[9px] font-bold px-2.5 py-1 rounded-full`}>
                  {post.badge}
                </div>
              </div>

              <!-- Content -->
              <p class="text-sm text-ink-700 leading-relaxed mb-3">{post.text}</p>

              {post.image && (
                <div class="rounded-xl bg-gradient-to-br from-brand-100 to-electric-100 h-24 mb-3 flex items-center justify-center text-2xl">
                  📸
                </div>
              )}

              <!-- Actions -->
              <div class="flex items-center gap-5 text-xs text-ink-400">
                <button class="flex items-center gap-1.5 hover:text-coral-500 transition-colors">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                  {post.likes}
                </button>
                <button class="flex items-center gap-1.5 hover:text-brand-500 transition-colors">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                  </svg>
                  {post.comments}
                </button>
                <button class="flex items-center gap-1.5 hover:text-ink-700 transition-colors ml-auto">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                  </svg>
                  Compartir
                </button>
              </div>
            </div>
          ))}
        </div>

        <!-- Decorative glow -->
        <div class="absolute -inset-8 -z-10 rounded-full blur-3xl opacity-20" style="background: radial-gradient(circle, #6366f1, transparent)"></div>
      </div>

      <!-- Text content -->
      <div>
        <p class="badge badge-brand mb-4">Red social del padel</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-ink-900">
          La comunidad que<br/>
          <span class="text-gradient-brand">vive el padel</span><br/>
          más allá de la pista.
        </h2>
        <p class="mt-5 text-ink-500 text-lg">
          No es un tablón de resultados. Es una red social diseñada para padeleros: publica, sigue, comparte logros y conecta con la gente que juega como tú.
        </p>

        <div class="mt-10 space-y-5">
          {features.map(f => (
            <div class="flex gap-4">
              <div class="h-12 w-12 shrink-0 rounded-2xl bg-surface ring-1 ring-ink-900/6 grid place-items-center text-xl">
                {f.icon}
              </div>
              <div>
                <h4 class="font-semibold text-ink-900">{f.title}</h4>
                <p class="text-sm text-ink-500 mt-0.5">{f.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
