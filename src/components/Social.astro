---
import { APP_SHARE_LINE } from '../lib/brand';

const socialFeatures = [
  { emoji: '👫', title: 'Mejor pareja', desc: 'Tu dúo con mejor winrate del club' },
  { emoji: '😈', title: 'Bestia negra', desc: 'Tu némesis con el historial de enfrentamientos' },
  { emoji: '🔥', title: 'Salseo', desc: 'Publicaciones con alma de vestuario' },
  { emoji: '💬', title: 'Mensajes', desc: 'Chat privado con tus compis de pista' },
];
---
<section class="py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="rounded-3xl bg-gradient-to-br from-salseo/10 via-cream to-brand-600/5 p-8 md:p-12">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="section-label">Comunidad</p>
          <h2 class="section-title mt-3">TU RED SOCIAL DEL PÁDEL</h2>
          <p class="mt-4 text-night-900/60">{APP_SHARE_LINE}. Feed del club, rivalidades sanas y
            momentos que solo entiende quien ha sudado en la pista.</p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          {
            socialFeatures.map((f) => (
              <div class="feature-card !p-4">
                <p class="text-2xl">{f.emoji}</p>
                <p class="mt-2 font-display text-base tracking-wide text-night-900">{f.title}</p>
                <p class="mt-1 text-xs text-night-900/50">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
