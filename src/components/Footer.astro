---
const year = new Date().getFullYear();
---
<footer class="bg-night-950 text-white">
  <div class="container-x pt-16 pb-8">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr_1fr]">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold text-white mb-5">
          <div class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-electric-600 shadow-glow-sm">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
              <ellipse cx="9.5" cy="9" rx="6.5" ry="7.5"/>
              <rect x="8.5" y="15" width="2" height="6" rx="1"/>
              <circle cx="17" cy="17" r="2.5"/>
            </svg>
          </div>
          PadelMVP
        </a>
        <p class="text-white/40 text-sm max-w-xs leading-relaxed">
          La comunidad del padelero exigente. Reserva, compite, gana insignias y vive el 3er tiempo.
        </p>
        <div class="flex gap-3 mt-6">
          {['in','📸','▶️'].map((s, i) => (
            <a href="#" class="h-9 w-9 rounded-xl bg-white/8 hover:bg-white/15 transition grid place-items-center text-white/60 hover:text-white text-sm font-bold ring-1 ring-white/10">
              {i === 0 ? 'in' : i === 1 ? 'ig' : 'yt'}
            </a>
          ))}
        </div>
      </div>

      <!-- Jugadores -->
      <div>
        <h4 class="text-white font-semibold mb-4">Jugadores</h4>
        <ul class="space-y-2.5">
          {[
            { href: '/#como-funciona', label: 'Cómo funciona' },
            { href: '/#ranking', label: 'Ranking y niveles' },
            { href: '/#insignias', label: 'Insignias' },
            { href: '/#torneos', label: 'Torneos' },
            { href: '/#tercer-tiempo', label: '3er Tiempo' },
            { href: '/#download', label: 'Descargar app' },
          ].map(l => (
            <li><a href={l.href} class="text-white/45 text-sm hover:text-white transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Clubs -->
      <div>
        <h4 class="text-white font-semibold mb-4">Para Clubs</h4>
        <ul class="space-y-2.5">
          {[
            { href: '/clubs', label: 'PadelMVP Manager' },
            { href: '/clubs#reservas', label: 'Reservas de pistas' },
            { href: '/clubs#app-clubs', label: 'App de tu club' },
            { href: '/clubs#precios', label: 'Precios' },
            { href: 'mailto:clubs@padelmvp.app', label: 'Pedir demo' },
          ].map(l => (
            <li><a href={l.href} class="text-white/45 text-sm hover:text-white transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h4 class="text-white font-semibold mb-4">Contacto</h4>
        <ul class="space-y-2.5">
          {[
            { href: 'mailto:hola@padelmvp.app', label: 'hola@padelmvp.app' },
            { href: 'mailto:clubs@padelmvp.app', label: 'clubs@padelmvp.app' },
            { href: '#', label: 'Política de privacidad' },
            { href: '#', label: 'Términos de uso' },
          ].map(l => (
            <li><a href={l.href} class="text-white/45 text-sm hover:text-white transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-white/8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/25">
      <p>© {year} PadelMVP — Hecho con pasión por padeleros, para padeleros.</p>
      <p>Hecho en España 🇪🇸</p>
    </div>
  </div>
</footer>
