---
export interface Props {
  variant?: 'home' | 'mvp' | 'booking' | 'wallet';
  className?: string;
  tilt?: 'left' | 'right' | 'none';
}
const { variant = 'home', className = '', tilt = 'left' } = Astro.props;
const tiltClass = tilt === 'left' ? 'phone-tilt' : tilt === 'right' ? 'phone-tilt-right' : '';
---
<div class={`relative ${tiltClass} ${className}`}>
  <!-- Glow halo -->
  <div class="absolute -inset-10 rounded-full bg-court-500/20 blur-3xl"></div>

  <!-- Device frame -->
  <div class="relative w-[300px] h-[610px] rounded-[44px] bg-gradient-to-b from-[#1c2538] to-[#0a0f1c] p-[10px] shadow-2xl shadow-black/60 ring-1 ring-white/10">
    <!-- Side glow edge -->
    <div class="absolute inset-0 rounded-[44px] ring-1 ring-court-400/20"></div>

    <!-- Screen -->
    <div class="relative h-full w-full overflow-hidden rounded-[36px] bg-night-900">
      <!-- Notch -->
      <div class="absolute top-2 left-1/2 -translate-x-1/2 z-30 h-6 w-28 rounded-full bg-black"></div>

      {variant === 'home' && (
        <div class="h-full w-full bg-gradient-to-b from-[#0a132a] via-[#070d1f] to-[#0a132a] p-4 pt-10 text-white">
          <div class="flex items-center justify-between text-[10px] text-white/60 px-1">
            <span>9:41</span>
            <span>● ● ●</span>
          </div>
          <div class="mt-3">
            <p class="text-[11px] text-white/50">Buenos días</p>
            <h3 class="text-lg font-display font-bold">Jon, listo para revancha?</h3>
          </div>
          <div class="mt-4 rounded-2xl bg-gradient-to-br from-court-400 to-court-600 p-4 text-night-900 shadow-glow">
            <p class="text-[10px] font-semibold uppercase tracking-wider">Próximo partido</p>
            <p class="mt-1 text-base font-bold">Club Padel Madrid</p>
            <p class="text-[11px] mt-1">Hoy · 20:30 · Pista 4</p>
            <div class="mt-3 flex -space-x-2">
              <div class="h-7 w-7 rounded-full bg-night-900 ring-2 ring-court-400 grid place-items-center text-[10px] font-bold">J</div>
              <div class="h-7 w-7 rounded-full bg-night-900 ring-2 ring-court-400 grid place-items-center text-[10px] font-bold">M</div>
              <div class="h-7 w-7 rounded-full bg-night-900 ring-2 ring-court-400 grid place-items-center text-[10px] font-bold">A</div>
              <div class="h-7 w-7 rounded-full bg-night-900 ring-2 ring-court-400 grid place-items-center text-[10px] font-bold">+1</div>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-2xl bg-white/5 p-3 ring-1 ring-white/10">
              <p class="text-[10px] text-white/50">Nivel</p>
              <p class="text-xl font-bold text-court-300">4.8</p>
              <div class="mt-1 h-1.5 w-full rounded-full bg-white/10"><div class="h-full w-[78%] rounded-full bg-court-400"></div></div>
            </div>
            <div class="rounded-2xl bg-white/5 p-3 ring-1 ring-white/10">
              <p class="text-[10px] text-white/50">MVPs</p>
              <p class="text-xl font-bold text-amber500">12</p>
              <p class="text-[10px] text-white/40">esta temporada</p>
            </div>
          </div>
          <div class="mt-4 rounded-2xl bg-white/5 p-3 ring-1 ring-white/10">
            <p class="text-[10px] text-white/50 font-semibold">PARTIDOS ABIERTOS CERCA</p>
            <div class="mt-2 space-y-2">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs font-semibold">Padel Indoor Centro</p>
                  <p class="text-[10px] text-white/50">19:00 · Nivel 4.5-5.0</p>
                </div>
                <span class="rounded-full bg-court-400 px-2 py-0.5 text-[10px] font-bold text-night-900">1/4</span>
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs font-semibold">Club Norte</p>
                  <p class="text-[10px] text-white/50">21:30 · Mixto</p>
                </div>
                <span class="rounded-full bg-amber500 px-2 py-0.5 text-[10px] font-bold text-night-900">2/4</span>
              </div>
            </div>
          </div>
        </div>
      )}

      {variant === 'mvp' && (
        <div class="h-full w-full bg-gradient-to-b from-[#1a0f00] via-[#070d1f] to-[#0a132a] p-4 pt-10 text-white">
          <div class="flex items-center justify-between text-[10px] text-white/60 px-1">
            <span>9:41</span>
            <span>● ● ●</span>
          </div>
          <div class="mt-6 text-center">
            <div class="mx-auto h-20 w-20 rounded-full bg-gradient-to-br from-amber500 to-court-400 grid place-items-center shadow-glow-amber">
              <svg class="h-10 w-10 text-night-900" viewBox="0 0 24 24" fill="currentColor"><path d="M5 16L3 6l5.5 4L12 4l3.5 6L21 6l-2 10H5zm0 2h14v2H5z"/></svg>
            </div>
            <p class="mt-3 text-[10px] uppercase tracking-widest text-amber500 font-bold">MVP del partido</p>
            <h3 class="font-display text-2xl font-bold mt-1">Jon Arenas</h3>
            <p class="text-[11px] text-white/60">Club Padel Madrid · Pista 4</p>
          </div>
          <div class="mt-5 rounded-2xl bg-white/5 p-4 ring-1 ring-white/10">
            <p class="text-[10px] text-white/50 font-semibold mb-2">VOTACIONES DEL PARTIDO</p>
            <div class="space-y-2">
              {['Jon A.', 'Marta C.', 'Alex P.', 'Sara L.'].map((n, i) => (
                <div>
                  <div class="flex justify-between text-[11px]"><span>{n}</span><span class="text-court-300 font-bold">{[3,2,1,1][i]} votos</span></div>
                  <div class="mt-1 h-1.5 rounded-full bg-white/10"><div class={`h-full rounded-full ${i===0?'bg-amber500 w-3/4':'bg-court-400 w-' + ['','2/4','1/4','1/4'][i]}`} style={i===0?'width:75%':i===1?'width:50%':'width:25%'}></div></div>
                </div>
              ))}
            </div>
          </div>
          <div class="mt-3 rounded-2xl bg-white/5 p-3 ring-1 ring-white/10">
            <p class="text-[10px] text-white/50 font-semibold">3er TIEMPO · La Birra</p>
            <p class="text-[11px] mt-1">Reservado para 4 · 22:00</p>
            <button class="mt-2 w-full rounded-full bg-court-400 py-1.5 text-[11px] font-bold text-night-900">Confirmar asistencia</button>
          </div>
        </div>
      )}

      {variant === 'booking' && (
        <div class="h-full w-full bg-gradient-to-b from-[#0a132a] via-[#070d1f] to-[#0a132a] p-4 pt-10 text-white">
          <div class="flex items-center justify-between text-[10px] text-white/60 px-1">
            <span>9:41</span>
            <span>● ● ●</span>
          </div>
          <div class="mt-3">
            <h3 class="text-lg font-display font-bold">Reservar pista</h3>
            <p class="text-[10px] text-white/50">Club Padel Madrid · 3 pistas indoor</p>
          </div>
          <div class="mt-3 flex gap-2 overflow-hidden">
            {['HOY','LUN','MAR','MIÉ','JUE'].map((d,i) => (
              <div class={`flex flex-col items-center justify-center w-12 h-14 rounded-xl ${i===0?'bg-court-400 text-night-900':'bg-white/5 text-white'}`}>
                <span class="text-[9px] font-semibold">{d}</span>
                <span class="text-base font-bold">{29+i}</span>
              </div>
            ))}
          </div>
          <div class="mt-3 grid grid-cols-3 gap-2">
            {['18:00','19:00','19:30','20:00','20:30','21:00'].map((h,i) => (
              <div class={`text-center py-2 rounded-xl text-[11px] font-semibold ${i===3?'bg-court-400 text-night-900':i===5?'bg-white/5 text-white/30 line-through':'bg-white/5 text-white'}`}>{h}</div>
            ))}
          </div>
          <div class="mt-3 rounded-2xl bg-white/5 p-3 ring-1 ring-white/10">
            <p class="text-[10px] text-white/50 font-semibold mb-2">PISTA</p>
            <div class="space-y-2">
              {[
                {n:'Pista 1 · Cristal', p:'24€', sel:false},
                {n:'Pista 4 · Premium', p:'28€', sel:true},
                {n:'Pista 2 · Cristal', p:'24€', sel:false},
              ].map(p => (
                <div class={`flex justify-between items-center p-2 rounded-xl ${p.sel?'bg-court-400/15 ring-1 ring-court-400':'bg-white/5'}`}>
                  <div>
                    <p class="text-xs font-semibold">{p.n}</p>
                    <p class="text-[10px] text-white/50">1h30 · 4 jugadores</p>
                  </div>
                  <span class="text-sm font-bold text-court-300">{p.p}</span>
                </div>
              ))}
            </div>
          </div>
          <button class="mt-3 w-full rounded-full bg-court-400 py-2.5 font-bold text-night-900 text-sm shadow-glow">Reservar · 28€</button>
        </div>
      )}

      {variant === 'wallet' && (
        <div class="h-full w-full bg-gradient-to-b from-[#0a132a] via-[#070d1f] to-[#0a132a] p-4 pt-10 text-white">
          <div class="flex items-center justify-between text-[10px] text-white/60 px-1">
            <span>9:41</span>
            <span>● ● ●</span>
          </div>
          <h3 class="mt-3 text-lg font-display font-bold">Mi cartera</h3>
          <div class="mt-3 rounded-2xl p-4 bg-gradient-to-br from-court-400 via-court-500 to-amber500 text-night-900 shadow-glow">
            <p class="text-[10px] font-bold uppercase tracking-widest">Saldo PadelMVP</p>
            <p class="text-3xl font-bold mt-1">84,50 €</p>
            <p class="text-[11px] mt-1 opacity-80">Pago instantáneo en clubs</p>
          </div>
          <div class="mt-4 grid grid-cols-3 gap-2">
            <button class="flex flex-col items-center gap-1 rounded-xl bg-white/5 p-2.5 ring-1 ring-white/10"><span class="text-base">⚡</span><span class="text-[10px]">Recargar</span></button>
            <button class="flex flex-col items-center gap-1 rounded-xl bg-white/5 p-2.5 ring-1 ring-white/10"><span class="text-base">↔</span><span class="text-[10px]">Dividir</span></button>
            <button class="flex flex-col items-center gap-1 rounded-xl bg-white/5 p-2.5 ring-1 ring-white/10"><span class="text-base">📜</span><span class="text-[10px]">Historial</span></button>
          </div>
          <div class="mt-4">
            <p class="text-[10px] text-white/50 font-semibold mb-2">ÚLTIMOS MOVIMIENTOS</p>
            <div class="space-y-2">
              {[
                {t:'Club Padel Madrid · Pista 4', a:'−7,00 €', d:'Hoy'},
                {t:'La Birra · 3er tiempo', a:'−12,50 €', d:'Ayer'},
                {t:'Recarga Bizum', a:'+50,00 €', d:'27/05'},
                {t:'Marta C. te ha enviado', a:'+14,00 €', d:'26/05'},
              ].map(m => (
                <div class="flex items-center justify-between rounded-xl bg-white/5 p-2.5 ring-1 ring-white/10">
                  <div>
                    <p class="text-[11px] font-semibold">{m.t}</p>
                    <p class="text-[10px] text-white/50">{m.d}</p>
                  </div>
                  <span class={`text-xs font-bold ${m.a.startsWith('+')?'text-court-300':'text-white'}`}>{m.a}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</div>
