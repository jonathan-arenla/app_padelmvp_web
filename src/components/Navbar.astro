---
---
<header id="navbar" class="fixed inset-x-0 top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100 transition-shadow duration-300">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="/logo.svg" alt="Padel MVP" class="h-10 w-auto" />
      <span class="font-display text-xl tracking-wider text-night-900">PADEL MVP</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-8 lg:flex">
      <!-- Para jugadores dropdown -->
      <div class="group relative">
        <button class="flex items-center gap-1 text-sm font-medium text-gray-600 transition hover:text-night-900">
          Para jugadores
          <svg class="h-4 w-4 transition group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute left-0 top-8 hidden min-w-[200px] rounded-2xl border border-gray-100 bg-white p-2 shadow-card group-hover:block">
          <a href="#como-funciona" class="block rounded-xl px-4 py-2.5 text-sm text-gray-600 hover:bg-cream hover:text-brand-600">Cómo funciona</a>
          <a href="#features" class="block rounded-xl px-4 py-2.5 text-sm text-gray-600 hover:bg-cream hover:text-brand-600">Funciones</a>
          <a href="#insignias" class="block rounded-xl px-4 py-2.5 text-sm text-gray-600 hover:bg-cream hover:text-brand-600">Insignias</a>
          <a href="#coins" class="block rounded-xl px-4 py-2.5 text-sm text-gray-600 hover:bg-cream hover:text-brand-600">PadelCoins</a>
        </div>
      </div>

      <a href="/clubs" class="text-sm font-medium text-gray-600 transition hover:text-night-900">Para clubs</a>
      <a href="#testimonios" class="text-sm font-medium text-gray-600 transition hover:text-night-900">Opiniones</a>
    </div>

    <!-- CTA -->
    <div class="flex items-center gap-3">
      <a href="#descargar" class="hidden text-sm font-medium text-gray-600 transition hover:text-night-900 lg:block">
        Iniciar sesión
      </a>
      <a href="#descargar" class="btn-primary !px-5 !py-2.5 !text-xs">
        Descargar gratis
      </a>
    </div>
  </nav>
</header>

<script>
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('shadow-md', window.scrollY > 10);
  }, { passive: true });
</script>
