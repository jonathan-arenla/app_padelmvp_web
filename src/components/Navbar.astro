---
const path = Astro.url.pathname;
const isClubs = path.startsWith('/clubs');
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" data-navbar>
  <div class="container-x">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold">
        <div class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-electric-600 text-white shadow-glow-sm">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
            <ellipse cx="9.5" cy="9" rx="6.5" ry="7.5"/>
            <rect x="8.5" y="15" width="2" height="6" rx="1"/>
            <circle cx="17" cy="17" r="2.5"/>
          </svg>
        </div>
        <span id="navbar-logo" class="transition-colors">PadelMVP</span>
      </a>

      <!-- Nav links -->
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
        <a href="/#como-funciona" class="nav-link rounded-lg px-3 py-2 transition-colors hover:text-brand-500">Cómo funciona</a>
        <a href="/#ranking" class="nav-link rounded-lg px-3 py-2 transition-colors hover:text-brand-500">Ranking</a>
        <a href="/#insignias" class="nav-link rounded-lg px-3 py-2 transition-colors hover:text-brand-500">Insignias</a>
        <a href="/#torneos" class="nav-link rounded-lg px-3 py-2 transition-colors hover:text-brand-500">Torneos</a>
        <div class="mx-2 h-4 w-px bg-current opacity-15"></div>
        <a
          href="/clubs"
          class={`nav-link rounded-lg px-3 py-2 transition-colors font-semibold ${isClubs ? 'text-brand-500' : 'hover:text-brand-500'}`}
        >
          Para Clubs
        </a>
      </nav>

      <!-- CTA -->
      <div class="flex items-center gap-2">
        <a href="/#download" class="hidden sm:inline-flex btn btn-ghost py-2 px-4 text-sm nav-ghost-btn">Descargar app</a>
        <a href={isClubs ? '#precios' : '/clubs'} class="btn btn-primary py-2 px-4 text-sm">
          {isClubs ? 'Ver precios' : 'Para clubs →'}
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer -->
<div class="h-16"></div>

<script>
  const navbar = document.querySelector('[data-navbar]') as HTMLElement;
  const logo = document.getElementById('navbar-logo');
  const navLinks = document.querySelectorAll('.nav-link');
  const ghostBtn = document.querySelector('.nav-ghost-btn');

  function updateNavbar() {
    const scrolled = window.scrollY > 40;
    if (scrolled) {
      navbar.style.background = 'rgba(255,255,255,0.95)';
      navbar.style.borderBottom = '1px solid rgba(15,23,42,0.08)';
      navbar.style.backdropFilter = 'blur(20px)';
      navbar.style.boxShadow = '0 4px 20px -4px rgba(15,23,42,0.10)';
      if (logo) logo.style.color = '#0b1020';
      navLinks.forEach(el => (el as HTMLElement).style.color = '#4a5170');
      if (ghostBtn) (ghostBtn as HTMLElement).style.color = '#0b1020';
    } else {
      navbar.style.background = 'transparent';
      navbar.style.borderBottom = 'none';
      navbar.style.backdropFilter = 'none';
      navbar.style.boxShadow = 'none';
      if (logo) logo.style.color = 'white';
      navLinks.forEach(el => (el as HTMLElement).style.color = 'rgba(255,255,255,0.85)');
      if (ghostBtn) (ghostBtn as HTMLElement).style.color = 'white';
    }
  }

  updateNavbar();
  window.addEventListener('scroll', updateNavbar, { passive: true });
</script>

<style>
  #navbar { color: white; }
  .nav-link { color: rgba(255,255,255,0.85); }
  .nav-ghost-btn { color: white; border-color: rgba(255,255,255,0.25); }
  .nav-ghost-btn:hover { border-color: white; background: rgba(255,255,255,0.1); }
  #navbar-logo { color: white; }
</style>
