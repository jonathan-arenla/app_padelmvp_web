---
const managerFeatures = [
  { t: 'Gestión de pistas en tiempo real', d: 'Calendario drag & drop, bloqueos por mantenimiento, multi-sede, tarifas dinámicas según demanda.' },
  { t: 'Reservas privadas para clubs', d: 'Crea eventos, ligas internas, clases o partidas privadas que solo ven tus socios.' },
  { t: 'Cobros y wallet integrada', d: 'Cobra al instante. Bizum, tarjeta, Apple/Google Pay. Conciliación automática y splits entre jugadores.' },
  { t: 'Membresías y abonos', d: 'Define tarifas, bonos de horas, descuentos por nivel o por categoría. Renovación automática.' },
  { t: 'Comunidad y matchmaking', d: 'Convierte tu base de clientes en una comunidad activa con MVPs, ligas, torneos y rankings propios.' },
  { t: 'Punto de venta + clases', d: 'Vende material, gestiona coaches, agenda clases grupales y privadas con cobro integrado.' },
];
---
<section id="manager" class="relative py-32 overflow-hidden">
  <div class="absolute inset-0 grid-pattern opacity-30"></div>
  <div class="absolute -top-32 -right-40 h-[500px] w-[500px] rounded-full bg-brand-200/60 blur-3xl"></div>

  <div class="container-x relative">
    <div class="grid lg:grid-cols-[1.05fr_1fr] gap-16 items-start">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full bg-coral-50 ring-1 ring-coral-200 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-coral-600">
          ✨ Nuevo · Para clubs
        </div>
        <h2 class="mt-5 font-display text-4xl md:text-6xl font-bold leading-[1.05]">
          <span class="text-gradient-brand">PadelMVP Manager</span><br/>
          Tu club, en piloto automático.
        </h2>
        <p class="mt-5 text-ink-500 text-lg max-w-xl">
          La plataforma de gestión más completa para clubs de padel. Gestiona pistas, cobros, socios,
          torneos y comunidad desde un único panel. Conectado a la app que ya usan miles de jugadores.
        </p>

        <div class="mt-10 grid sm:grid-cols-2 gap-5">
          {managerFeatures.map(f => (
            <div class="rounded-2xl bg-white p-5 ring-1 ring-ink-900/5 shadow-card transition hover:shadow-glow hover:-translate-y-0.5">
              <p class="font-semibold text-ink-900">{f.t}</p>
              <p class="mt-1 text-sm text-ink-500">{f.d}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#pricing" class="btn-primary">Ver planes para clubs</a>
          <a href="#demo" class="btn-ghost">Pedir demo →</a>
        </div>
      </div>

      <!-- Manager dashboard mockup -->
      <div class="relative card-3d">
        <div class="absolute -inset-12 bg-brand-200/60 blur-3xl rounded-full"></div>
        <div class="relative bg-white rounded-3xl p-5 shadow-soft ring-1 ring-ink-900/5 animate-float-slow"
             style="transform: perspective(1500px) rotateX(6deg) rotateY(-8deg);">
          <!-- Header -->
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <div class="h-2.5 w-2.5 rounded-full bg-red-400"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-yellow-400"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-court-400"></div>
            </div>
            <p class="text-xs text-ink-300">manager.padelmvp.app · Club Padel Madrid</p>
          </div>
          <!-- Top stats -->
          <div class="grid grid-cols-3 gap-3">
            <div class="rounded-2xl bg-cream ring-1 ring-ink-900/5 p-3">
              <p class="text-[10px] uppercase tracking-widest text-ink-500">Ocupación hoy</p>
              <p class="mt-1 text-2xl font-bold text-brand-600">87%</p>
              <p class="text-[10px] text-court-600">+12% vs ayer</p>
            </div>
            <div class="rounded-2xl bg-cream ring-1 ring-ink-900/5 p-3">
              <p class="text-[10px] uppercase tracking-widest text-ink-500">Facturación</p>
              <p class="mt-1 text-2xl font-bold text-ink-900">2.847€</p>
              <p class="text-[10px] text-coral-600">+8% semana</p>
            </div>
            <div class="rounded-2xl bg-cream ring-1 ring-ink-900/5 p-3">
              <p class="text-[10px] uppercase tracking-widest text-ink-500">Socios activos</p>
              <p class="mt-1 text-2xl font-bold text-ink-900">412</p>
              <p class="text-[10px] text-court-600">+18 nuevos</p>
            </div>
          </div>
          <!-- Court grid -->
          <div class="mt-4 rounded-2xl bg-cream ring-1 ring-ink-900/5 p-3">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs font-semibold text-ink-900">Pistas · Hoy</p>
              <p class="text-[10px] text-ink-500">17:00 — 22:00</p>
            </div>
            <div class="space-y-2">
              {['Pista 1', 'Pista 2', 'Pista 3', 'Pista 4'].map((c, i) => (
                <div class="flex items-center gap-2">
                  <span class="text-[10px] w-16 text-ink-500">{c}</span>
                  <div class="flex-1 grid grid-cols-10 gap-1 h-6">
                    {Array(10).fill(0).map((_, j) => {
                      const filled = (i + j) % 3 !== 0;
                      const isPrivate = (i + j) % 5 === 0;
                      return (
                        <div class={`rounded-md ${filled ? (isPrivate ? 'bg-coral-400' : 'bg-brand-500') : 'bg-ink-900/10'}`}></div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-3 flex gap-3 text-[10px] text-ink-500">
              <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-brand-500"></span>Reservada</span>
              <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-coral-400"></span>Privada/Club</span>
              <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-ink-900/10"></span>Disponible</span>
            </div>
          </div>
          <!-- Mini chart -->
          <div class="mt-3 rounded-2xl bg-cream ring-1 ring-ink-900/5 p-3">
            <div class="flex justify-between items-center mb-2">
              <p class="text-xs font-semibold text-ink-900">Ingresos · 7 días</p>
              <p class="text-[10px] text-court-600">+14,5%</p>
            </div>
            <svg viewBox="0 0 280 60" class="w-full h-14">
              <defs>
                <linearGradient id="gradient1" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#2f5fff" stop-opacity="0.5"/>
                  <stop offset="100%" stop-color="#2f5fff" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0 45 L40 38 L80 42 L120 25 L160 30 L200 18 L240 22 L280 8 L280 60 L0 60 Z" fill="url(#gradient1)"/>
              <path d="M0 45 L40 38 L80 42 L120 25 L160 30 L200 18 L240 22 L280 8" fill="none" stroke="#2f5fff" stroke-width="2"/>
            </svg>
          </div>
        </div>

        <!-- Floating action -->
        <div class="absolute -bottom-4 -left-4 bg-white rounded-2xl p-3 shadow-card animate-float-mid ring-1 ring-ink-900/5">
          <p class="text-[10px] uppercase tracking-widest text-court-600 font-bold">Cobro recibido</p>
          <p class="text-sm font-bold text-ink-900">+28,00 € · Pista 4</p>
        </div>
      </div>
    </div>
  </div>
</section>
