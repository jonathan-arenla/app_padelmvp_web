---
---
<section class="relative min-h-screen overflow-hidden bg-night-950 flex flex-col" style="margin-top: -64px; padding-top: 64px;">
  <!-- Background layers -->
  <div class="absolute inset-0 grid-pattern"></div>
  <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(47,95,255,0.20) 0%, transparent 70%)"></div>
  <div class="absolute inset-0" style="background: radial-gradient(ellipse 50% 40% at 85% 60%, rgba(99,102,241,0.12) 0%, transparent 60%)"></div>
  <div class="absolute inset-0" style="background: radial-gradient(ellipse 40% 30% at 10% 80%, rgba(255,90,23,0.08) 0%, transparent 60%)"></div>

  <div class="container-x relative flex-1 flex items-center py-20">
    <div class="w-full grid lg:grid-cols-2 gap-12 items-center">

      <!-- Text -->
      <div class="text-white">
        <!-- Pill -->
        <div class="inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/8 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-white/70 backdrop-blur-sm mb-8">
          <span class="h-1.5 w-1.5 rounded-full bg-court-400 animate-pulse-dot"></span>
          Temporada 2026 · Ya disponible
        </div>

        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.04] tracking-tight">
          No es solo<br/>
          una app de<br/>
          <span class="text-gradient-brand">padel.</span>
        </h1>

        <p class="mt-6 text-lg text-white/60 max-w-md leading-relaxed">
          Reserva, compite, gana insignias, vota tu MVP y vive el <strong class="text-white/90">3er tiempo</strong>. La comunidad de padeleros que lo vive más allá de la pista.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#download" class="btn-primary text-base shadow-glow">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 12.04c-.03-2.85 2.33-4.22 2.44-4.29-1.34-1.96-3.42-2.23-4.16-2.26-1.78-.18-3.46.96-4.36.96-.91 0-2.29-.94-3.78-.91-1.94.03-3.74 1.14-4.74 2.88-2.04 3.54-.52 8.76 1.45 11.62.97 1.4 2.11 2.96 3.59 2.91 1.45-.06 2-.94 3.74-.94 1.75 0 2.25.94 3.79.91 1.57-.03 2.55-1.42 3.5-2.83 1.13-1.62 1.59-3.21 1.62-3.29-.04-.02-3.11-1.2-3.14-4.76z"/></svg>
            Descargar gratis
          </a>
          <a href="#como-funciona" class="btn-ghost-dark text-base">
            Cómo funciona ↓
          </a>
        </div>

        <!-- Social proof -->
        <div class="mt-12 flex items-center gap-5">
          <div class="flex -space-x-2.5">
            {['J','M','A','R','S'].map((l, i) => (
              <div class="h-9 w-9 rounded-full ring-2 ring-night-950 grid place-items-center text-white text-[11px] font-bold"
                   style={`background: linear-gradient(135deg, hsl(${220 + i*30},80%,55%), hsl(${250 + i*30},70%,45%))`}>
                {l}
              </div>
            ))}
          </div>
          <div class="text-sm text-white/60">
            <p class="text-white font-semibold">★★★★★ 4.9 · +24.000 jugadores</p>
            <p>ya están en la comunidad</p>
          </div>
        </div>
      </div>

      <!-- Phone stack -->
      <div class="relative flex justify-center items-center min-h-[580px]">
        <!-- Glow behind phones -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="h-80 w-80 rounded-full bg-brand-500/20 blur-3xl"></div>
        </div>

        <!-- Phone 1 — Perfil / Ranking -->
        <div class="absolute left-0 top-8 animate-float-slow z-20" style="transform-origin: center;">
          <div class="w-52 bg-night-800 rounded-[1.8rem] p-2.5 shadow-card-dark ring-1 ring-white/10">
            <div class="bg-night-900 rounded-[1.4rem] overflow-hidden">
              <!-- Header dorado -->
              <div class="p-3" style="background: linear-gradient(135deg, #92680a, #d97706, #f59e0b);">
                <div class="flex justify-between items-start mb-2">
                  <p class="text-white/70 text-[9px] font-bold uppercase tracking-wider">Mi Perfil</p>
                  <span class="bg-white/20 text-white text-[9px] font-bold px-2 py-0.5 rounded-full">● ORO</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="h-10 w-10 rounded-xl bg-night-900/40 grid place-items-center text-lg font-bold text-white">A</div>
                  <div>
                    <p class="text-white font-bold text-sm">ALEX</p>
                    <p class="text-white/60 text-[9px]">@alex_padel</p>
                  </div>
                </div>
                <!-- Rating -->
                <div class="mt-2 bg-night-900/30 rounded-xl p-2 flex items-center gap-2">
                  <span class="font-display text-2xl font-bold text-white">74</span>
                  <div>
                    <p class="text-white text-[9px] font-bold">RATING MVP</p>
                    <p class="text-white/60 text-[9px]">Faltan 7 pts → Diamante</p>
                  </div>
                </div>
              </div>
              <!-- Stats -->
              <div class="grid grid-cols-3 gap-px bg-white/5 text-center text-[9px]">
                {[['15','wins'],['88%','ratio'],['17','partidos']].map(([v,l]) => (
                  <div class="bg-night-900 py-2">
                    <p class="font-bold text-white text-sm">{v}</p>
                    <p class="text-white/40">{l}</p>
                  </div>
                ))}
              </div>
              <!-- Badges -->
              <div class="p-3">
                <p class="text-white/40 text-[8px] uppercase tracking-wider mb-2">Insignias</p>
                <div class="flex gap-1.5">
                  {['🛡️','💣','⚡'].map(icon => (
                    <div class="flex-1 bg-white/8 rounded-xl py-2 grid place-items-center text-base ring-1 ring-white/10">{icon}</div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Phone 2 — Liga / Ligas (center, main) -->
        <div class="relative z-30 animate-float" style="animation-delay: 1s;">
          <div class="w-60 bg-night-800 rounded-[2rem] p-3 shadow-card-dark ring-1 ring-white/10">
            <div class="bg-night-900 rounded-[1.6rem] overflow-hidden">
              <!-- Header -->
              <div class="bg-night-800 px-4 pt-4 pb-3">
                <div class="flex justify-between items-center mb-3">
                  <p class="text-white font-bold text-sm">Mis Ligas</p>
                  <button class="bg-brand-500 text-white text-[9px] font-bold px-2.5 py-1 rounded-full">+ Nueva</button>
                </div>
                <!-- Search bar -->
                <div class="bg-white/8 rounded-xl px-3 py-2 flex items-center gap-2">
                  <svg class="h-3 w-3 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                  <span class="text-white/30 text-[10px]">Buscar torneo o jugador...</span>
                </div>
              </div>
              <!-- Club cards -->
              <div class="p-3 space-y-2">
                <p class="text-white/40 text-[9px] uppercase tracking-wider">Clubs de la zona</p>
                <div class="rounded-xl overflow-hidden ring-1 ring-white/10">
                  <div class="h-14 bg-gradient-to-br from-brand-700 to-brand-900 flex items-end p-2">
                    <div>
                      <span class="text-[8px] bg-court-500/80 text-white px-1.5 py-0.5 rounded font-bold">OUTDOOR</span>
                      <p class="text-white text-[10px] font-bold mt-0.5">Club Esportiu Gran Via Mar</p>
                      <p class="text-white/60 text-[8px]">● 7 pistas</p>
                    </div>
                  </div>
                </div>
                <!-- Liga card -->
                <p class="text-white/40 text-[9px] uppercase tracking-wider pt-1">Mayo 2026</p>
                <div class="rounded-xl bg-white/8 ring-1 ring-white/10 p-2.5">
                  <p class="text-white text-[10px] font-bold">Liga PROD TEST</p>
                  <p class="text-white/40 text-[8px]">Liga Regular · 0 partidos</p>
                </div>
              </div>
              <!-- Tab bar -->
              <div class="border-t border-white/8 grid grid-cols-5 py-2">
                {['⊞','🏆','➕','💬','👤'].map((icon, i) => (
                  <div class={`grid place-items-center text-sm py-1 ${i === 1 ? 'text-gold-400' : 'text-white/30'}`}>{icon}</div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Phone 3 — Insignias -->
        <div class="absolute right-0 top-16 animate-float-mid z-20" style="animation-delay: 2s;">
          <div class="w-52 bg-night-800 rounded-[1.8rem] p-2.5 shadow-card-dark ring-1 ring-white/10">
            <div class="bg-night-900 rounded-[1.4rem] overflow-hidden">
              <div class="p-3 border-b border-white/8">
                <p class="text-white/40 text-[9px] font-bold">3 conseguidas · toca para ver cómo</p>
              </div>
              <div class="p-3 space-y-2">
                {[
                  { name: 'El Muro', quote: '"Lo devuelve todo."', level: 'Platino', count: '×294', color: 'from-red-700 to-orange-600', icon: '🛡️' },
                  { name: 'El Cañonero', quote: '"Smash y a casa."', level: 'Platino', count: '×98', color: 'from-orange-600 to-amber-500', icon: '💣' },
                  { name: 'El MVP', quote: '"El mejor del campo."', level: 'Platino', count: '×3', color: 'from-purple-700 to-indigo-600', icon: '👑' },
                ].map(b => (
                  <div class="flex items-center gap-2.5 bg-white/6 rounded-xl p-2 ring-1 ring-white/8">
                    <div class={`h-9 w-9 rounded-xl bg-gradient-to-br ${b.color} grid place-items-center text-base shrink-0`}>{b.icon}</div>
                    <div class="min-w-0">
                      <div class="flex items-center justify-between">
                        <p class="text-white text-[10px] font-bold">{b.name}</p>
                        <span class="text-gold-400 text-[8px] font-bold">{b.count}</span>
                      </div>
                      <p class="text-white/40 text-[8px] italic">{b.quote}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Floating notification -->
        <div class="absolute bottom-10 left-4 bg-white rounded-2xl px-4 py-3 shadow-xl animate-float-mid z-40 ring-1 ring-ink-900/8" style="animation-delay:0.5s;">
          <p class="text-[9px] uppercase tracking-widest text-court-600 font-bold">🏆 Votado MVP</p>
          <p class="text-sm font-bold text-ink-900">+50 pts · +8 MVP Rating</p>
        </div>
        <div class="absolute top-4 right-6 bg-night-800 rounded-2xl px-3 py-2 shadow-card-dark animate-float-slow z-40 ring-1 ring-white/10" style="animation-delay:1.5s;">
          <p class="text-[9px] uppercase tracking-widest text-gold-400 font-bold">💎 Diamante</p>
          <p class="text-xs font-bold text-white">Nuevo rango!</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee strip -->
  <div class="border-t border-white/8 bg-night-900/80 backdrop-blur-sm overflow-hidden py-4 mt-4">
    <div class="flex gap-10 whitespace-nowrap animate-marquee text-white/40 font-display font-semibold uppercase tracking-widest text-xs">
      {Array(2).fill(0).map(() => (
        <div class="flex gap-10 shrink-0">
          {['· Reservas en 2 toques','· Ranking Bronce → Diamante','· Insignias por IA + comunidad','· Torneos con cuadros','· MVP por votación','· 3er tiempo organizado','· Red social de padeleros','· Stats avanzadas','· 0% comisión'].map(t => (
            <span>{t}</span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
