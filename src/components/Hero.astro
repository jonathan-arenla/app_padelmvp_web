---
import { attributes } from '../lib/ranks';
const attrValues = [82, 79, 88, 91, 76, 85];
---
<section class="relative overflow-hidden bg-white pt-24 pb-16 lg:pb-0">

  <!-- Blue blob bg (Playtomic style) -->
  <div class="absolute right-0 top-0 h-full w-1/2 overflow-hidden pointer-events-none">
    <svg viewBox="0 0 800 700" class="absolute right-0 top-0 h-full w-auto opacity-100" preserveAspectRatio="xMaxYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="blobGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:#1040f5;stop-opacity:1"/>
          <stop offset="100%" style="stop-color:#0d1a3e;stop-opacity:1"/>
        </linearGradient>
      </defs>
      <path d="M200,0 L800,0 L800,700 L100,700 Q0,600 50,400 Q100,200 200,0Z" fill="url(#blobGrad)"/>
    </svg>
  </div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-8 px-6 py-12 lg:grid-cols-2 lg:py-20">

    <!-- Left: Text -->
    <div class="z-10">
      <div class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-4 py-1.5 text-xs font-semibold text-brand-600 mb-6">
        🎾 La app de pádel amateur
      </div>

      <!-- Playtomic-style headline: mix bold + italic -->
      <h1 class="font-display text-5xl leading-[1.0] tracking-wide text-night-900 sm:text-6xl lg:text-7xl">
        <span class="block">COMPITE,</span>
        <span class="block text-gradient-brand italic">EVOLUCIONA,</span>
        <span class="block">DOMINA.</span>
      </h1>

      <p class="mt-6 max-w-lg text-lg leading-relaxed text-gray-500">
        Registra cada partido, sube de rango ELO, vota al MVP y colecciona insignias con tus compis del club.
        <strong class="text-night-900">El partido no acaba en la pista.</strong>
      </p>

      <!-- App store buttons — Playtomic style -->
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#descargar" class="inline-flex items-center gap-3 rounded-2xl bg-night-900 px-5 py-3.5 text-white transition hover:bg-night-800">
          <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <div class="text-left">
            <p class="text-[10px] leading-none opacity-60">Próximamente en</p>
            <p class="text-sm font-bold leading-tight">App Store</p>
          </div>
        </a>
        <a href="#descargar" class="inline-flex items-center gap-3 rounded-2xl bg-night-900 px-5 py-3.5 text-white transition hover:bg-night-800">
          <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a1.77 1.77 0 0 1-.465-.635 1.86 1.86 0 0 1-.144-.742V3.291c0-.271.05-.534.144-.742a1.77 1.77 0 0 1 .464-.635zm2.502 20.453l9.326-9.326-2.562-2.562-6.764 11.888zm9.326-11.05l2.562-2.562L6.111 1.814l6.326 9.303zM16.437 3.291v17.418l5.553-5.553-5.553-9.865z"/>
          </svg>
          <div class="text-left">
            <p class="text-[10px] leading-none opacity-60">Próximamente en</p>
            <p class="text-sm font-bold leading-tight">Google Play</p>
          </div>
        </a>
      </div>

      <!-- Stats row (Playtomic style) -->
      <div class="mt-12 flex gap-8 border-t border-gray-100 pt-8">
        <div>
          <p class="font-display text-3xl text-night-900">14</p>
          <p class="text-xs text-gray-400">Insignias únicas</p>
        </div>
        <div class="border-l border-gray-100 pl-8">
          <p class="font-display text-3xl text-night-900">5</p>
          <p class="text-xs text-gray-400">Rangos ELO</p>
        </div>
        <div class="border-l border-gray-100 pl-8">
          <p class="font-display text-3xl text-night-900">∞</p>
          <p class="text-xs text-gray-400">Rivales por batir</p>
        </div>
      </div>
    </div>

    <!-- Right: Phone mockup on blue bg -->
    <div class="relative z-10 flex justify-center lg:justify-end">
      <div class="relative animate-float">
        <!-- Phone -->
        <div class="relative h-[560px] w-[260px] rounded-[2.8rem] border-4 border-white/20 bg-white/10 p-2 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.4)] backdrop-blur-sm">
          <div class="absolute left-1/2 top-3 z-10 h-6 w-20 -translate-x-1/2 rounded-full bg-black/30"></div>
          <div class="h-full w-full overflow-hidden rounded-[2.2rem] bg-gray-900">
            <!-- App UI mockup -->
            <div class="flex h-full flex-col bg-white">
              <!-- App top bar -->
              <div class="flex items-center justify-between bg-night-900 px-4 pt-10 pb-3">
                <img src="/logo.svg" alt="" class="h-8 w-8"/>
                <div class="flex gap-2">
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10">🏅</div>
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10">🔔</div>
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-500 text-xs font-bold text-white">CM</div>
                </div>
              </div>
              <!-- Card FIFA style -->
              <div class="m-3 rounded-2xl bg-gradient-to-br from-night-700 to-night-900 p-4 text-white shadow-lg">
                <div class="flex items-start justify-between">
                  <div>
                    <p class="font-display text-4xl text-gold-400">87</p>
                    <p class="text-[9px] uppercase tracking-widest text-gold-400/70">Rating ELO</p>
                  </div>
                  <div class="rounded-lg bg-gold-500/20 px-2 py-1 text-xs font-bold text-gold-400">ORO</div>
                </div>
                <div class="mx-auto my-3 flex h-16 w-16 items-center justify-center rounded-full bg-brand-600/30 text-3xl">🎾</div>
                <p class="text-center font-display text-lg tracking-wider">CARLOS M.</p>
                <p class="text-center text-[9px] text-white/40">Club Padel Norte · Madrid</p>
                <div class="mt-3 grid grid-cols-3 gap-1">
                  {attributes.map((attr, i) => (
                    <div class="rounded bg-white/5 px-1 py-1 text-center">
                      <p class="text-[8px] text-white/40">{attr.key}</p>
                      <p class="text-xs font-bold">{attrValues[i]}</p>
                    </div>
                  ))}
                </div>
              </div>
              <!-- Recent activity -->
              <div class="px-3 pb-2">
                <p class="mb-2 text-[10px] font-bold uppercase tracking-wider text-gray-400">Actividad reciente</p>
                <div class="flex items-center gap-2 rounded-xl bg-gray-50 px-3 py-2">
                  <span class="text-lg">👑</span>
                  <div>
                    <p class="text-xs font-bold text-night-900">MVP del partido</p>
                    <p class="text-[10px] text-gray-400">Hace 2h · Club Padel Norte</p>
                  </div>
                  <span class="ml-auto text-xs font-bold text-orange-500">+5 🪙</span>
                </div>
                <div class="mt-1 flex items-center gap-2 rounded-xl bg-gray-50 px-3 py-2">
                  <span class="text-lg">⚡</span>
                  <div>
                    <p class="text-xs font-bold text-night-900">El Clutch desbloqueada</p>
                    <p class="text-[10px] text-gray-400">Insignia Bronce</p>
                  </div>
                </div>
              </div>
              <!-- Bottom nav -->
              <div class="mt-auto flex border-t border-gray-100">
                {['⊞','🏆','＋','💬','👤'].map((icon, i) => (
                  <div class:list={['flex flex-1 flex-col items-center py-2', i === 2 ? 'text-orange-500' : 'text-gray-300']}>
                    <span class="text-lg">{icon}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Floating insignia -->
        <div class="absolute -left-10 top-20 animate-float-delayed rounded-2xl bg-white px-3 py-2.5 shadow-card">
          <div class="flex items-center gap-2">
            <span class="text-xl">🧱</span>
            <div>
              <p class="text-xs font-bold text-night-900">El Muro</p>
              <p class="text-[10px] text-gray-400">Insignia Oro ✨</p>
            </div>
          </div>
        </div>

        <!-- Floating streak -->
        <div class="absolute -right-8 bottom-28 animate-float rounded-2xl bg-white px-3 py-2 shadow-card">
          <p class="text-xs font-bold text-orange-500">🔥 Racha ×5</p>
          <p class="text-[10px] text-gray-400">victorias seguidas</p>
        </div>
      </div>
    </div>

  </div>
</section>
