---
const steps = [
  {
    step: '1',
    title: 'Juega tu partido',
    desc: 'Regístralo manualmente o impórtalo con un enlace desde cualquier app.',
  },
  {
    step: '2',
    title: 'Abre el 3er tiempo',
    desc: 'Vota MVP, reparte insignias y valora a tus rivales en 4 skills.',
  },
  {
    step: '3',
    title: 'Sube de rango',
    desc: 'Tu ELO y atributos se actualizan. Gana PadelCoins y presume en el muro.',
  },
  {
    step: '4',
    title: 'Compite en ligas',
    desc: 'Crea o únete a ligas del club. Rankings en vivo y americanas exprés.',
  },
];
---
<section id="como-funciona" class="bg-surface py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-label">Flujo</p>
      <h2 class="section-title mt-3">CÓMO FUNCIONA</h2>
      <p class="mt-4 text-night-900/60">De la pista al muro en menos de 2 minutos.</p>
    </div>

    <div class="relative mt-16">
      <div class="absolute left-0 right-0 top-8 hidden h-0.5 bg-brand-600/20 lg:block"></div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <div class="relative text-center">
              <div class="relative z-10 mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-600 font-display text-2xl text-white shadow-glow-sm">
                {s.step}
              </div>
              <h3 class="mt-4 font-display text-lg tracking-wide text-night-900">{s.title}</h3>
              <p class="mt-2 text-sm text-night-900/60">{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
