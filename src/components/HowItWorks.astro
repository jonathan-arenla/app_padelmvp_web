---
const steps = [
  {
    num: '01',
    icon: '⚡',
    title: 'Reserva',
    sub: 'Pista en 2 toques',
    desc: 'Encuentra pista disponible cerca de ti, elige hora y nivel, paga con Bizum, wallet o Apple Pay. Sin llamadas.',
    color: 'from-brand-500 to-electric-600',
    glow: 'rgba(47,95,255,0.3)',
  },
  {
    num: '02',
    icon: '🏓',
    title: 'Juega',
    sub: 'Compite y crece',
    desc: 'Partidos abiertos por nivel real, ligas, torneos. El algoritmo te pone con rivales de tu nivel. Cada punto cuenta para tu rating.',
    color: 'from-coral-500 to-coral-400',
    glow: 'rgba(255,90,23,0.3)',
  },
  {
    num: '03',
    icon: '🍻',
    title: 'Vive el 3er tiempo',
    sub: 'El alma del padel',
    desc: 'Vota al MVP, gana insignias, reserva mesa en bares aliados y divide la cuenta. El padel no termina en la pista.',
    color: 'from-gold-500 to-gold-400',
    glow: 'rgba(245,158,11,0.3)',
  },
];
---

<section id="como-funciona" class="relative py-24 bg-surface overflow-hidden">
  <div class="absolute inset-0 grid-pattern-light"></div>
  <div class="container-x relative">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="badge badge-brand mb-4">La experiencia completa</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-ink-900">
        Más que una app.<br/>
        <span class="text-gradient-brand">Una forma de vivir el padel.</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 relative">
      <!-- Connector lines (desktop) -->
      <div class="hidden md:block absolute top-14 left-1/3 right-1/3 h-px" style="background: linear-gradient(90deg, rgba(47,95,255,0.2), rgba(99,102,241,0.2), rgba(245,158,11,0.2))"></div>

      {steps.map((s, i) => (
        <div class="card card-hover p-8 relative overflow-hidden group">
          <!-- Top glow -->
          <div class="absolute -top-12 -right-12 h-32 w-32 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"
               style={`background: ${s.glow}`}></div>

          <!-- Number -->
          <div class="font-display text-6xl font-bold opacity-8 text-ink-900 absolute top-6 right-6">{s.num}</div>

          <!-- Icon -->
          <div class={`relative h-14 w-14 rounded-2xl bg-gradient-to-br ${s.color} grid place-items-center text-2xl shadow-lg mb-6`}>
            {s.icon}
          </div>

          <p class="text-xs font-bold uppercase tracking-widest text-ink-400 mb-1">{s.sub}</p>
          <h3 class="font-display text-2xl font-bold text-ink-900 mb-3">{s.title}</h3>
          <p class="text-ink-500 leading-relaxed">{s.desc}</p>

          <!-- Bottom accent line -->
          <div class={`absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r ${s.color} opacity-0 group-hover:opacity-100 transition-opacity`}></div>
        </div>
      ))}
    </div>

    <!-- Stats row -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { v: '+24k', l: 'Jugadores activos', icon: '👥' },
        { v: '+340', l: 'Clubs asociados', icon: '🏟️' },
        { v: '1.2M', l: 'Partidos jugados', icon: '🎾' },
        { v: '4.9★', l: 'Valoración en stores', icon: '⭐' },
      ].map(s => (
        <div class="card p-6 text-center card-hover">
          <div class="text-2xl mb-2">{s.icon}</div>
          <p class="font-display text-3xl font-bold text-ink-900">{s.v}</p>
          <p class="text-sm text-ink-500 mt-1">{s.l}</p>
        </div>
      ))}
    </div>
  </div>
</section>
