---
const plans = [
  {
    name: 'Player',
    target: 'Para jugadores',
    price: 'Gratis',
    period: '',
    desc: 'Para empezar, reservar y entrar en la comunidad.',
    features: [
      'Reservas en clubs PadelMVP',
      'Partidos abiertos por nivel',
      'MVP Rating y ranking',
      'Wallet + Bizum + Apple/Google Pay',
      'Chat y grupos de partido',
      'Perfil con insignias',
    ],
    cta: 'Descargar gratis',
    ctaStyle: 'btn-ghost w-full mt-6',
    highlight: false,
    badge: null,
  },
  {
    name: 'Player Pro',
    target: 'Para jugadores',
    price: '3,99€',
    period: '/ mes',
    desc: 'Para los que viven el padel cada semana.',
    features: [
      'Todo lo de Player',
      'Stats avanzadas y progresión',
      'Vídeos del partido automáticos',
      'Descuentos exclusivos en clubs',
      '0% comisión en reservas',
      'Acceso a torneos premium',
      'Soporte prioritario',
    ],
    cta: 'Probar 14 días gratis',
    ctaStyle: 'btn-ghost w-full mt-6',
    highlight: false,
    badge: 'Más popular',
  },
  {
    name: 'Club',
    target: 'Para clubs',
    price: '49€',
    period: '/ mes',
    desc: 'Digitaliza tu club. Reservas, cobros y comunidad.',
    features: [
      'Hasta 6 pistas gestionadas',
      'Reservas online 24/7',
      'Cobros automáticos',
      'Dashboard y reports básicos',
      'App con marca PadelMVP',
      'Ligas y torneos internos',
      'Soporte email',
    ],
    cta: 'Empezar 14 días gratis',
    ctaStyle: 'btn-primary w-full mt-6',
    highlight: true,
    badge: 'Top clubs',
  },
  {
    name: 'Club Pro',
    target: 'Para clubs',
    price: '129€',
    period: '/ mes',
    desc: 'La solución completa. App propia, multi-sede y más.',
    features: [
      'Todo lo de Club',
      'Pistas ilimitadas',
      'App con TU marca (App Store & Google Play)',
      'Multi-sede centralizado',
      'POS + membresías + clases',
      'Reports avanzados y exportables',
      'API de integración',
      'Soporte 4h + account manager',
    ],
    cta: 'Hablar con ventas',
    ctaStyle: 'btn-ghost w-full mt-6',
    highlight: false,
    badge: null,
  },
];
---

<section id="precios" class="relative py-28 overflow-hidden bg-white">
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(47,95,255,0.3), transparent)"></div>

  <div class="container-x">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="badge badge-brand mb-4">Precios</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-ink-900">
        Más completo.<br/>
        <span class="text-gradient-brand">Hasta un 45% más barato.</span>
      </h2>
      <p class="mt-4 text-ink-500 text-lg">
        Sin permanencias. Sin comisiones por reserva. 14 días de prueba gratis en cualquier plan.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {plans.map(p => (
        <div class={`relative flex flex-col rounded-3xl p-7 transition-all duration-300 hover:-translate-y-1 ${p.highlight ? 'bg-night-900 ring-2 ring-brand-500 shadow-glow' : 'bg-white ring-1 ring-ink-900/8 shadow-card hover:shadow-xl'}`}>
          {p.badge && (
            <span class={`absolute -top-3 left-6 rounded-full px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white ${p.highlight ? 'bg-brand-500' : 'bg-coral-500'}`}>
              {p.badge}
            </span>
          )}

          <p class={`text-[11px] uppercase tracking-widest font-bold ${p.highlight ? 'text-white/40' : 'text-ink-400'}`}>{p.target}</p>
          <h3 class={`mt-1 font-display text-2xl font-bold ${p.highlight ? 'text-white' : 'text-ink-900'}`}>{p.name}</h3>
          <p class={`mt-2 text-sm min-h-[40px] ${p.highlight ? 'text-white/50' : 'text-ink-500'}`}>{p.desc}</p>

          <div class="mt-5 flex items-end gap-1">
            <span class={`font-display text-4xl font-bold ${p.highlight ? 'text-white' : 'text-ink-900'}`}>{p.price}</span>
            <span class={`pb-1 text-sm ${p.highlight ? 'text-white/50' : 'text-ink-400'}`}>{p.period}</span>
          </div>

          <ul class="mt-6 space-y-2.5 flex-1">
            {p.features.map(f => (
              <li class={`flex gap-2.5 text-sm ${p.highlight ? 'text-white/70' : 'text-ink-600'}`}>
                <svg class={`h-5 w-5 shrink-0 mt-0.5 ${p.highlight ? 'text-brand-400' : 'text-brand-500'}`} viewBox="0 0 20 20" fill="currentColor">
                  <path d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <a href={p.name === 'Club Pro' ? 'mailto:clubs@padelmvp.app' : '#download'} class={p.ctaStyle}>{p.cta}</a>
        </div>
      ))}
    </div>

    <!-- Comparison note -->
    <div class="mt-14 flex flex-wrap items-center justify-center gap-6 text-sm text-ink-500">
      {[
        '✓ Sin comisión por reserva',
        '✓ Sin permanencias',
        '✓ 14 días gratis',
        '✓ Soporte humano',
        '✓ Setup en 48h',
      ].map(item => (
        <span class="flex items-center gap-1.5 font-medium">{item}</span>
      ))}
    </div>
  </div>
</section>
