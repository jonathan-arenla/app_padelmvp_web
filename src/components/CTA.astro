---
import PhoneMockup from './PhoneMockup.astro';
---
<section id="download" class="relative py-32 overflow-hidden">
  <div class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-brand-300 to-transparent"></div>
  <div class="container-x">
    <div class="relative rounded-[40px] p-10 md:p-16 overflow-hidden bg-gradient-to-br from-brand-600 to-brand-800 text-white shadow-glow">
      <div class="absolute -top-32 -right-20 h-[400px] w-[400px] rounded-full bg-coral-400/30 blur-3xl"></div>
      <div class="absolute -bottom-32 -left-10 h-[400px] w-[400px] rounded-full bg-brand-300/30 blur-3xl"></div>

      <div class="relative grid lg:grid-cols-[1.2fr_1fr] gap-12 items-center">
        <div>
          <h2 class="font-display text-4xl md:text-6xl font-bold leading-[1.05] text-white">
            ¿Listo para vivir el padel <span class="text-coral-300">como nunca</span>?
          </h2>
          <p class="mt-5 text-white/80 text-lg max-w-xl">
            Descárgate la app gratis. Sin registro tedioso. Tu primera reserva con 5€ de regalo en wallet.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#" class="flex items-center gap-3 rounded-2xl bg-white text-ink-900 px-5 py-3 shadow-card hover:bg-cream transition">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.05 12.04c-.03-2.85 2.33-4.22 2.44-4.29-1.34-1.96-3.42-2.23-4.16-2.26-1.78-.18-3.46.96-4.36.96-.91 0-2.29-.94-3.78-.91-1.94.03-3.74 1.14-4.74 2.88-2.04 3.54-.52 8.76 1.45 11.62.97 1.4 2.11 2.96 3.59 2.91 1.45-.06 2-.94 3.74-.94 1.75 0 2.25.94 3.79.91 1.57-.03 2.55-1.42 3.5-2.83 1.13-1.62 1.59-3.21 1.62-3.29-.04-.02-3.11-1.2-3.14-4.76zM14.83 4.61c.8-.96 1.34-2.3 1.19-3.62-1.15.05-2.55.77-3.37 1.73-.74.85-1.39 2.21-1.22 3.51 1.28.1 2.6-.66 3.4-1.62z"/>
              </svg>
              <div class="text-left">
                <p class="text-[10px] uppercase">Descargar en</p>
                <p class="font-bold leading-tight">App Store</p>
              </div>
            </a>
            <a href="#" class="flex items-center gap-3 rounded-2xl bg-white text-ink-900 px-5 py-3 shadow-card hover:bg-cream transition">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.6 1.7c-.4.4-.6 1-.6 1.7v17.2c0 .7.2 1.3.6 1.7l.1.1L13.4 12 3.7 1.6l-.1.1zm10.6 11l3.3 3.3-11.4 6.5c-.4.2-.7.2-1.1.1l9.2-9.9zm0-1.4L4.9 1.4c.4-.1.7-.1 1.1.1l11.4 6.5-3.2 3.3zm6 2.3l-2.8 1.6-3.1-3.2L17.4 9l2.8 1.6c.7.4.7 1.4 0 1.8z"/>
              </svg>
              <div class="text-left">
                <p class="text-[10px] uppercase">Descargar en</p>
                <p class="font-bold leading-tight">Google Play</p>
              </div>
            </a>
          </div>

          <div class="mt-10 flex items-center gap-6 text-sm text-white/70">
            <div>
              <p class="font-display text-2xl font-bold text-white">+24k</p>
              <p>Usuarios activos</p>
            </div>
            <div class="w-px h-10 bg-white/20"></div>
            <div>
              <p class="font-display text-2xl font-bold text-white">+180</p>
              <p>Clubs aliados</p>
            </div>
            <div class="w-px h-10 bg-white/20"></div>
            <div>
              <p class="font-display text-2xl font-bold text-white">4.9★</p>
              <p>Valoración media</p>
            </div>
          </div>
        </div>

        <div class="relative flex justify-center card-3d">
          <div class="animate-float-slow">
            <PhoneMockup variant="wallet" tilt="right" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
