---
---
<section id="download" class="relative py-24 overflow-hidden bg-night-950">
  <div class="absolute inset-0 grid-pattern"></div>
  <div class="absolute inset-0" style="background: radial-gradient(ellipse 70% 60% at 50% 100%, rgba(47,95,255,0.18) 0%, transparent 70%)"></div>

  <div class="container-x relative">
    <div class="max-w-3xl mx-auto text-center">
      <div class="text-6xl mb-6">🎾</div>
      <h2 class="font-display text-5xl md:text-6xl font-bold text-white leading-[1.05]">
        ¿Listo para vivir<br/>
        el padel <span class="text-gradient-brand">como nunca</span>?
      </h2>
      <p class="mt-5 text-white/50 text-xl max-w-xl mx-auto">
        Descárgate la app gratis. Tu primera reserva con <strong class="text-white">5€ de regalo</strong> en wallet. Sin registro tedioso.
      </p>

      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href="#" class="flex items-center gap-3 rounded-2xl bg-white px-6 py-4 shadow-card hover:bg-surface transition-all hover:-translate-y-0.5 hover:shadow-xl">
          <svg class="h-7 w-7 text-ink-900" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.05 12.04c-.03-2.85 2.33-4.22 2.44-4.29-1.34-1.96-3.42-2.23-4.16-2.26-1.78-.18-3.46.96-4.36.96-.91 0-2.29-.94-3.78-.91-1.94.03-3.74 1.14-4.74 2.88-2.04 3.54-.52 8.76 1.45 11.62.97 1.4 2.11 2.96 3.59 2.91 1.45-.06 2-.94 3.74-.94 1.75 0 2.25.94 3.79.91 1.57-.03 2.55-1.42 3.5-2.83 1.13-1.62 1.59-3.21 1.62-3.29-.04-.02-3.11-1.2-3.14-4.76zM14.83 4.61c.8-.96 1.34-2.3 1.19-3.62-1.15.05-2.55.77-3.37 1.73-.74.85-1.39 2.21-1.22 3.51 1.28.1 2.6-.66 3.4-1.62z"/>
          </svg>
          <div class="text-left">
            <p class="text-[10px] text-ink-500 uppercase font-medium">Descargar en</p>
            <p class="font-bold text-ink-900 leading-tight">App Store</p>
          </div>
        </a>
        <a href="#" class="flex items-center gap-3 rounded-2xl bg-white px-6 py-4 shadow-card hover:bg-surface transition-all hover:-translate-y-0.5 hover:shadow-xl">
          <svg class="h-7 w-7 text-ink-900" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.6 1.7c-.4.4-.6 1-.6 1.7v17.2c0 .7.2 1.3.6 1.7l.1.1L13.4 12 3.7 1.6l-.1.1zm10.6 11l3.3 3.3-11.4 6.5c-.4.2-.7.2-1.1.1l9.2-9.9zm0-1.4L4.9 1.4c.4-.1.7-.1 1.1.1l11.4 6.5-3.2 3.3zm6 2.3l-2.8 1.6-3.1-3.2L17.4 9l2.8 1.6c.7.4.7 1.4 0 1.8z"/>
          </svg>
          <div class="text-left">
            <p class="text-[10px] text-ink-500 uppercase font-medium">Descargar en</p>
            <p class="font-bold text-ink-900 leading-tight">Google Play</p>
          </div>
        </a>
      </div>

      <!-- Stats -->
      <div class="mt-14 flex items-center justify-center gap-8 md:gap-14">
        {[
          { v: '+24k', l: 'Usuarios' },
          { v: '+340', l: 'Clubs' },
          { v: '4.9★', l: 'Valoración' },
          { v: '1.2M', l: 'Partidos' },
        ].map(s => (
          <div class="text-center">
            <p class="font-display text-3xl font-bold text-white">{s.v}</p>
            <p class="text-white/40 text-sm mt-0.5">{s.l}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
