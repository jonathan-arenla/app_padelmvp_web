---
const features = [
  'Conecta fácilmente con otros jugadores de tu club',
  'Localiza rivales de tu nivel y reta al ranking',
  'Registra partidos y gestiona tus resultados desde el móvil',
  'Sigue tu progreso con el sistema de rating ELO',
  'Ve tus estadísticas e historial de partidos en tiempo real',
  'Comparte tus trofeos, insignias y victorias con tus compis',
];
---
<section id="features" class="bg-cream py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid items-center gap-16 lg:grid-cols-2">

      <!-- Features list -->
      <div>
        <p class="section-label">La app</p>
        <h2 class="font-display text-4xl leading-none tracking-wide text-night-900 sm:text-5xl mt-3">
          CONECTA CON<br />
          <span class="text-brand-600">NUESTRA APP</span>
        </h2>
        <p class="mt-4 text-gray-500">Todo lo que pasa después del partido, en tu bolsillo.</p>

        <ul class="mt-8 space-y-3">
          {features.map(f => (
            <li class="flex items-start gap-3">
              <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-600 text-[10px] text-white">✓</div>
              <span class="text-gray-600">{f}</span>
            </li>
          ))}
        </ul>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#descargar" class="btn-primary">
            Descargar la app
          </a>
          <a href="#descargar" class="btn-outline">
            Saber más
          </a>
        </div>
      </div>

      <!-- App screenshot -->
      <div class="relative flex justify-center">
        <div class="relative rounded-3xl overflow-hidden bg-white aspect-[3/4] w-64 shadow-card border border-gray-100">
          <div class="flex flex-col h-full items-center justify-center gap-3 p-6 text-center text-gray-200">
            <img src="/logo.svg" class="h-16 w-16 opacity-20" alt=""/>
            <p class="text-sm">Añade /screenshots/torneo.png</p>
          </div>
          <img
            src="/screenshots/torneo.png"
            alt="Crear torneo en Padel MVP"
            class="absolute inset-0 h-full w-full object-cover object-top"
            onerror="this.style.display='none'"
          />
        </div>
        <!-- Floating card -->
        <div class="absolute -left-4 bottom-8 rounded-2xl bg-white p-3 shadow-card border border-gray-100 max-w-[160px]">
          <p class="text-xs font-bold text-night-900">🏆 Liga Verano activa</p>
          <p class="mt-1 text-[10px] text-gray-400">8 jugadores · 3 jornadas restantes</p>
          <div class="mt-2 h-1.5 w-full rounded-full bg-gray-100">
            <div class="h-1.5 rounded-full bg-brand-600" style="width:60%"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
