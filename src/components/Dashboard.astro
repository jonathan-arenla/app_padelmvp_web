---
const kpis = [
  { l: 'Reservas mes', v: '1.284', d: '+22%', up: true },
  { l: 'Ticket medio', v: '24,80€', d: '+3,1%', up: true },
  { l: 'No-shows', v: '1,2%', d: '−40%', up: true },
  { l: 'NPS jugadores', v: '78', d: '+12 pts', up: true },
];
---
<section id="dashboard" class="relative py-28 overflow-hidden bg-cream">
  <div class="container-x">
    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-16 items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-brand-600 font-bold">Dashboard & Reports</p>
        <h2 class="mt-3 font-display text-4xl md:text-5xl font-bold">Decisiones basadas en <span class="text-gradient-brand">datos reales</span>, no en intuiciones.</h2>
        <p class="mt-5 text-ink-500 text-lg">Cada reserva, cada socio, cada cobro: en un dashboard claro y reports exportables. Identifica las franjas más rentables, los socios en riesgo de fuga y las pistas infrautilizadas.</p>

        <div class="mt-8 grid grid-cols-2 gap-4">
          {kpis.map(k => (
            <div class="rounded-2xl bg-white p-5 ring-1 ring-ink-900/5 shadow-card">
              <p class="text-[11px] uppercase tracking-widest text-ink-500">{k.l}</p>
              <p class="mt-1 font-display text-3xl font-bold text-ink-900">{k.v}</p>
              <p class={`mt-1 text-xs font-semibold ${k.up ? 'text-court-600' : 'text-red-500'}`}>↑ {k.d}</p>
            </div>
          ))}
        </div>

        <ul class="mt-8 space-y-3 text-ink-700">
          <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-brand-600"></span> Heatmaps de ocupación por hora y día.</li>
          <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-brand-600"></span> Reports automáticos en PDF/Excel.</li>
          <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-brand-600"></span> Segmentación de socios y campañas push.</li>
          <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-brand-600"></span> Integraciones contables y fiscales.</li>
        </ul>
      </div>

      <!-- Big dashboard mock -->
      <div class="relative card-3d">
        <div class="absolute -inset-16 bg-coral-200/60 blur-3xl rounded-full"></div>
        <div class="relative bg-white rounded-3xl overflow-hidden shadow-soft ring-1 ring-ink-900/5"
             style="transform: perspective(1500px) rotateX(4deg) rotateY(6deg);">
          <div class="flex items-center justify-between border-b border-ink-900/5 px-5 py-3">
            <p class="font-semibold text-ink-900">Reports · Mayo 2026</p>
            <div class="flex gap-2">
              <span class="text-[10px] rounded-full bg-brand-50 text-brand-600 px-2 py-0.5 ring-1 ring-brand-200">En vivo</span>
              <span class="text-[10px] rounded-full bg-cream text-ink-500 px-2 py-0.5 ring-1 ring-ink-900/5">PDF</span>
            </div>
          </div>
          <div class="p-5 space-y-4">
            <!-- Heatmap -->
            <div>
              <p class="text-[11px] uppercase tracking-widest text-ink-500 mb-2">Heatmap de ocupación</p>
              <div class="grid grid-cols-[40px_1fr] gap-2">
                <div class="space-y-1.5 text-[10px] text-ink-300">
                  <p>L</p><p>M</p><p>X</p><p>J</p><p>V</p><p>S</p><p>D</p>
                </div>
                <div class="grid grid-rows-7 gap-1.5">
                  {Array(7).fill(0).map((_, row) => (
                    <div class="grid grid-cols-12 gap-1">
                      {Array(12).fill(0).map((_, col) => {
                        const value = Math.abs(Math.sin((row + 1) * (col + 1) * 0.7));
                        const opacity = 0.10 + value * 0.85;
                        return <div class="h-4 rounded-sm" style={`background-color: rgba(47,95,255,${opacity})`}></div>;
                      })}
                    </div>
                  ))}
                </div>
              </div>
              <div class="mt-2 flex justify-between text-[10px] text-ink-300">
                <span>8h</span><span>14h</span><span>20h</span><span>23h</span>
              </div>
            </div>

            <!-- Combo chart -->
            <div>
              <p class="text-[11px] uppercase tracking-widest text-ink-500 mb-2">Ingresos vs reservas</p>
              <svg viewBox="0 0 400 110" class="w-full h-28">
                <defs>
                  <linearGradient id="bargrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#ff7a3a" stop-opacity="0.9"/>
                    <stop offset="100%" stop-color="#ff7a3a" stop-opacity="0.2"/>
                  </linearGradient>
                </defs>
                {Array(12).fill(0).map((_, i) => {
                  const h = 30 + Math.abs(Math.sin(i * 0.9)) * 60;
                  return <rect x={i * 32 + 6} y={100 - h} width="20" height={h} fill="url(#bargrad)" rx="3"/>;
                })}
                <path d="M0 70 Q40 50 80 55 T160 35 T240 40 T320 20 T400 30" fill="none" stroke="#2f5fff" stroke-width="2.5"/>
                {[0,80,160,240,320,400].map(x => (
                  <circle cx={x} cy={x===0?70:x===80?52:x===160?35:x===240?40:x===320?20:30} r="3" fill="#2f5fff"/>
                ))}
              </svg>
            </div>

            <!-- Table -->
            <div>
              <p class="text-[11px] uppercase tracking-widest text-ink-500 mb-2">Top reservas</p>
              <div class="space-y-1.5 text-xs">
                {[
                  { n: 'Jon Arenas', r: '12 reservas', e: '297 €' },
                  { n: 'Marta C.', r: '9 reservas', e: '224 €' },
                  { n: 'Alex P.', r: '7 reservas', e: '178 €' },
                ].map(r => (
                  <div class="flex justify-between rounded-lg bg-cream px-3 py-1.5">
                    <span class="text-ink-900">{r.n}</span>
                    <span class="text-ink-500">{r.r}</span>
                    <span class="font-bold text-brand-600">{r.e}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
