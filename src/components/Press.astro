---
const mentions = [
  {
    outlet: 'El País',
    quote: '"La app que está cambiando cómo los padeleros amateurs viven su deporte favorito."',
    url: '#',
  },
  {
    outlet: 'Marca',
    quote: '"Padel MVP convierte cada partido amateur en una experiencia de pádel profesional."',
    url: '#',
  },
  {
    outlet: 'AS',
    quote: '"La red social del pádel que miles de jugadores estaban esperando."',
    url: '#',
  },
  {
    outlet: 'Xataka',
    quote: '"Una app que gamifica el pádel amateur como nadie lo había hecho antes."',
    url: '#',
  },
];
---
<section class="border-t border-b border-gray-100 bg-white py-20">
  <div class="mx-auto max-w-7xl px-6">
    <p class="mb-12 text-center text-sm font-semibold uppercase tracking-[0.2em] text-gray-400">
      Hablan de nosotros
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {mentions.map(m => (
        <a
          href={m.url}
          class="group rounded-2xl border border-gray-100 bg-white p-5 transition hover:border-brand-200 hover:shadow-card"
        >
          <p class="font-display text-xl tracking-wide text-night-900 group-hover:text-brand-600 transition">{m.outlet}</p>
          <p class="mt-3 text-sm leading-relaxed text-gray-500 italic">{m.quote}</p>
        </a>
      ))}
    </div>
  </div>
</section>
