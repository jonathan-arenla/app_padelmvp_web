---
const features = [
  {
    icon: '🏆',
    title: 'MVP del partido',
    desc: 'Cada partido tiene un MVP. Vota, gana puntos, sube de Bronce a Diamante y desbloquea insignias únicas que definen tu estilo de juego.',
    accent: 'from-coral-200 to-transparent',
  },
  {
    icon: '💎',
    title: 'Ranking Diamante · Oro · Plata · Bronce',
    desc: 'Sistema de rating global que evoluciona con cada partido. La IA y la comunidad validan tu nivel real. ¿Eres Diamante?',
    accent: 'from-brand-200 to-transparent',
  },
  {
    icon: '⚡',
    title: 'Reserva en 2 toques',
    desc: 'Encuentra pista, hora y nivel ideal. Pago con wallet, Bizum, Apple/Google Pay. Sin sorpresas.',
    accent: 'from-brand-200 to-transparent',
  },
  {
    icon: '🎯',
    title: 'Partidos abiertos by skill',
    desc: 'Únete a partidos según tu nivel real, no autodeclarado. Matchmaking validado por la comunidad.',
    accent: 'from-coral-200 to-transparent',
  },
  {
    icon: '📊',
    title: 'Stats que importan',
    desc: 'Winrate, racha, % drive vs revés, posiciones y evolución mensual. Tus insignias reflejan cómo juegas realmente.',
    accent: 'from-brand-200 to-transparent',
  },
  {
    icon: '👥',
    title: 'Tu cuadrilla',
    desc: 'Grupos privados, chats integrados, encuestas para horarios y recordatorios automáticos. Nunca más "al final venís?".',
    accent: 'from-coral-200 to-transparent',
  },
];
---
<section id="features" class="relative py-28">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="text-xs uppercase tracking-[0.3em] text-brand-600 font-bold">Para jugadores</p>
      <h2 class="mt-3 font-display text-4xl md:text-5xl font-bold">Features pensadas para los que <span class="text-gradient-brand">aman el padel</span>.</h2>
      <p class="mt-4 text-ink-500 text-lg">No otra app de reservas. Una experiencia diseñada por padeleros exigentes que quieren más que una pista: comunidad, picaresca y tercer tiempo.</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3 card-3d">
      {features.map(f => (
        <div class="feature-card group relative overflow-hidden">
          <div class={`absolute -top-12 -right-12 h-40 w-40 rounded-full bg-gradient-to-br ${f.accent} blur-2xl opacity-70`}></div>
          <div class="relative">
            <div class="grid h-12 w-12 place-items-center rounded-2xl bg-cream ring-1 ring-ink-900/5 text-2xl shadow-soft">{f.icon}</div>
            <h3 class="mt-5 font-display text-xl font-bold text-ink-900">{f.title}</h3>
            <p class="mt-2 text-ink-500 leading-relaxed">{f.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
