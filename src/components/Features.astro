---
const features = [
  {
    icon: '📊',
    title: 'Rating ELO & Carta FIFA',
    desc: '6 atributos (SAQ, RES, VOL, SMA, DEF, MEN) y 5 rangos metálicos. Tu carta evoluciona con cada partido verificado.',
    color: 'from-gold-500/20 to-gold-500/5',
  },
  {
    icon: '🏅',
    title: '14 Insignias',
    desc: 'El Muro, El Cañonero, Fair Play, El Clutch… Cada una con tiers de Bronce a Platino según veces conseguidas.',
    color: 'from-brand-600/20 to-brand-600/5',
  },
  {
    icon: '🏆',
    title: 'Ligas & Americanas',
    desc: 'Round-robin por jornadas o torneos exprés con parejas aleatorias. Invita con enlace y sigue el ranking en vivo.',
    color: 'from-lime-500/20 to-lime-500/5',
  },
  {
    icon: '💬',
    title: 'Muro & Salseo',
    desc: 'Feed del club con resultados, trofeos, historias y salseo. Mejor pareja, bestia negra y mensajes privados.',
    color: 'from-salseo/20 to-salseo/5',
  },
  {
    icon: '🔗',
    title: 'Importa tus partidos',
    desc: 'Pega el enlace de tu partido y lo importamos. Sin reescribir resultados a mano después de cada sesión.',
    color: 'from-diamond/20 to-diamond/5',
  },
  {
    icon: '🪙',
    title: 'PadelCoins & Tienda',
    desc: '+5 coins por partido verificado. Canjea grips, pelotas, ropa y palas de marcas reales en la tienda.',
    color: 'from-victory/20 to-victory/5',
  },
];
---
<section id="features" class="py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-label">Funciones</p>
      <h2 class="section-title mt-3">TODO LO QUE NECESITAS DESPUÉS DEL PARTIDO</h2>
      <p class="mt-4 text-night-900/60">
        Desde registrar el marcador hasta presumir tu carta en Instagram. Una app, cero fricción.
      </p>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="feature-card group">
            <div
              class:list={[
                'mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br text-2xl transition group-hover:scale-110',
                f.color,
              ]}
            >
              {f.icon}
            </div>
            <h3 class="font-display text-xl tracking-wide text-night-900">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-night-900/60">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
