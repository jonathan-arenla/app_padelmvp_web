---
---
<section id="descargar" class="relative overflow-hidden py-28">
  <!-- Navy bg -->
  <div class="absolute inset-0 section-navy"></div>
  <div class="absolute left-1/2 top-0 h-[400px] w-[800px] -translate-x-1/2 rounded-full bg-brand-600/20 blur-[100px] pointer-events-none"></div>

  <div class="relative mx-auto max-w-3xl px-6 text-center">
    <img src="/logo.svg" alt="Padel MVP" class="mx-auto h-20 w-20 mb-6"/>
    <h2 class="font-display text-5xl tracking-wide text-white sm:text-6xl">
      PADEL MVP
    </h2>
    <p class="mt-3 text-xl text-white/70 font-light">Para padeleros exigentes.</p>
    <p class="mt-2 text-sm text-white/40">
      Disponible pronto en iOS y Android. Únete a la lista de espera.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="#" class="inline-flex items-center gap-3 rounded-2xl bg-white px-6 py-4 text-night-900 shadow-card transition hover:shadow-glow">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        <div class="text-left">
          <p class="text-[10px] leading-none opacity-50">Próximamente en</p>
          <p class="text-sm font-bold leading-tight">App Store</p>
        </div>
      </a>
      <a href="#" class="inline-flex items-center gap-3 rounded-2xl bg-white px-6 py-4 text-night-900 shadow-card transition hover:shadow-glow">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3.609 1.814L13.792 12 3.61 22.186a1.77 1.77 0 0 1-.465-.635 1.86 1.86 0 0 1-.144-.742V3.291c0-.271.05-.534.144-.742a1.77 1.77 0 0 1 .464-.635zm2.502 20.453l9.326-9.326-2.562-2.562-6.764 11.888zm9.326-11.05l2.562-2.562L6.111 1.814l6.326 9.303zM16.437 3.291v17.418l5.553-5.553-5.553-9.865z"/>
        </svg>
        <div class="text-left">
          <p class="text-[10px] leading-none opacity-50">Próximamente en</p>
          <p class="text-sm font-bold leading-tight">Google Play</p>
        </div>
      </a>
    </div>

    <p class="mt-8 text-xs text-white/30">
      ¿Tienes un club? <a href="/clubs" class="text-brand-300 hover:text-white underline">Descubre Padel MVP para clubs →</a>
    </p>
  </div>
</section>
