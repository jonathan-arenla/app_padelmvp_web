---
const formats = [
  {
    icon: '🏆',
    name: 'Liga Regular',
    desc: 'Todos contra todos. Clasificación semanal. Ideal para grupos de amigos o socios de club.',
    features: ['Grupos de 4–8 parejas', 'Calendario auto-generado', 'Tabla de clasificación en vivo'],
    color: 'from-brand-600 to-electric-600',
  },
  {
    icon: '⚡',
    name: 'Torneo con cuadro',
    desc: 'Eliminatoria directa con cuadro visual. Drama, tensión y una sola final.',
    features: ['Cuadro de 8, 16 o 32 equipos', 'Resultados en tiempo real', 'Historial de partidos'],
    color: 'from-coral-600 to-coral-400',
  },
  {
    icon: '🎯',
    name: 'American (americano)',
    desc: 'El formato social por excelencia. Todos con todos, parejas cambiantes.',
    features: ['Parejas rotativas automáticas', 'Ranking individual final', 'Ideal para eventos de club'],
    color: 'from-gold-600 to-gold-400',
  },
  {
    icon: '🔥',
    name: 'King of the Court',
    desc: 'Los mejores se quedan. Los que pierden rotan. El trono lo decide la pista.',
    features: ['Sistema de retos', 'Cambia de pista al perder', 'Formato rápido de 1–2h'],
    color: 'from-purple-600 to-pink-500',
  },
];
---

<section id="torneos" class="relative py-28 overflow-hidden bg-night-950">
  <div class="absolute inset-0 grid-pattern"></div>
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,90,23,0.4), transparent)"></div>
  <!-- Glow -->
  <div class="absolute -top-40 left-1/3 h-96 w-96 rounded-full blur-3xl opacity-15" style="background: radial-gradient(circle, #f97316, transparent)"></div>
  <div class="absolute -bottom-20 right-1/4 h-64 w-64 rounded-full blur-3xl opacity-10" style="background: radial-gradient(circle, #6366f1, transparent)"></div>

  <div class="container-x relative">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-16 items-center">
      <div>
        <p class="badge badge-dark mb-4">Competición</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-white">
          Crea torneos en<br/>
          <span class="text-gradient-brand">minutos.</span><br/>
          Compite de verdad.
        </h2>
        <p class="mt-5 text-white/50 text-lg">
          Cualquier padelero puede crear un torneo. Cualquier club puede organizarlo para sus socios. Cuadros, ligas, americanos, king of the court.
        </p>

        <!-- Format cards -->
        <div class="mt-10 space-y-3">
          {formats.map(f => (
            <div class="group flex items-center gap-4 rounded-2xl border border-white/8 bg-white/4 px-5 py-4 transition-all hover:bg-white/8 hover:border-white/15 cursor-pointer">
              <div class={`h-12 w-12 shrink-0 rounded-xl bg-gradient-to-br ${f.color} grid place-items-center text-xl`}>
                {f.icon}
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="font-display font-bold text-white text-sm">{f.name}</h4>
                <p class="text-white/45 text-xs mt-0.5">{f.desc}</p>
              </div>
              <svg class="h-4 w-4 text-white/30 shrink-0 group-hover:text-white/60 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          ))}
        </div>

        <a href="#download" class="mt-8 inline-flex btn-primary">
          Crear un torneo gratis →
        </a>
      </div>

      <!-- Tournament bracket mockup -->
      <div class="relative">
        <div class="absolute -inset-8 rounded-full blur-3xl opacity-20" style="background: radial-gradient(circle, #f97316, transparent)"></div>
        <div class="relative rounded-3xl border border-white/10 bg-night-800 p-6 shadow-card-dark">
          <!-- Header -->
          <div class="flex items-center justify-between mb-5">
            <div>
              <h4 class="font-display font-bold text-white">Liga Mayo 2026</h4>
              <p class="text-white/40 text-xs">Liga Regular · 8 equipos</p>
            </div>
            <span class="text-[10px] font-bold uppercase tracking-wider bg-court-500/20 text-court-400 px-2.5 py-1 rounded-full ring-1 ring-court-500/30">● En curso</span>
          </div>

          <!-- Clasificación table -->
          <div class="rounded-2xl bg-night-900 overflow-hidden mb-4">
            <div class="grid grid-cols-[1.5fr_1fr_1fr_1fr_1fr] gap-2 px-4 py-2 text-[9px] font-bold uppercase tracking-wider text-white/30">
              <span>Pareja</span><span class="text-center">PJ</span><span class="text-center">G</span><span class="text-center">P</span><span class="text-center">Pts</span>
            </div>
            {[
              { name: 'Alex & Marc', pj:6, g:5, p:1, pts:15, rank:1, color:'text-gold-400', badge:'💎' },
              { name: 'Jon & Sara', pj:6, g:4, p:2, pts:12, rank:2, color:'text-brand-400', badge:'🥈' },
              { name: 'Raul & Pedro', pj:6, g:3, p:3, pts:9, rank:3, color:'text-white/70', badge:'🥉' },
              { name: 'Marta & Ana', pj:6, g:2, p:4, pts:6, rank:4, color:'text-white/40', badge:'' },
              { name: 'Carlos & Luis', pj:5, g:1, p:4, pts:3, rank:5, color:'text-white/30', badge:'' },
            ].map(r => (
              <div class={`grid grid-cols-[1.5fr_1fr_1fr_1fr_1fr] gap-2 px-4 py-2.5 text-xs border-t border-white/5 items-center ${r.rank === 1 ? 'bg-gold-500/8' : ''}`}>
                <div class="flex items-center gap-2">
                  <span class="text-white/30 text-[9px] w-3">{r.rank}</span>
                  <span class={`font-semibold ${r.color}`}>{r.name}</span>
                  <span class="text-xs">{r.badge}</span>
                </div>
                <span class="text-center text-white/50">{r.pj}</span>
                <span class="text-center text-court-400 font-semibold">{r.g}</span>
                <span class="text-center text-coral-400">{r.p}</span>
                <span class={`text-center font-bold ${r.rank === 1 ? 'text-gold-400' : 'text-white/70'}`}>{r.pts}</span>
              </div>
            ))}
          </div>

          <!-- Próximo partido -->
          <div class="rounded-2xl bg-brand-500/10 border border-brand-500/20 px-4 py-3">
            <p class="text-brand-300 text-[10px] font-bold uppercase tracking-wider mb-2">Próximo partido</p>
            <div class="flex items-center justify-between">
              <div class="text-center">
                <p class="text-white font-bold text-sm">Alex & Marc</p>
                <p class="text-white/40 text-[9px]">💎 Diamante</p>
              </div>
              <div class="text-center">
                <p class="text-white/50 text-xs font-bold">VS</p>
                <p class="text-white/40 text-[9px]">Sáb 14:30</p>
              </div>
              <div class="text-center">
                <p class="text-white font-bold text-sm">Jon & Sara</p>
                <p class="text-white/40 text-[9px]">🥇 Oro</p>
              </div>
            </div>
          </div>

          <!-- Floating MVP badge -->
          <div class="absolute -top-3 -right-3 bg-gold-500 rounded-2xl px-3 py-2 shadow-glow-gold">
            <p class="text-white text-[9px] font-bold uppercase">MVP Liga</p>
            <p class="text-white text-xs font-bold">Alex P. 👑</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
