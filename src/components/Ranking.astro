---
const tiers = [
  {
    name: 'Bronce',
    range: '0 – 39',
    icon: '🥉',
    color: 'from-amber-800 to-amber-600',
    glow: 'rgba(180,83,9,0.4)',
    textColor: '#d97706',
    desc: 'Estás empezando. Cada partido te enseña algo nuevo.',
    perks: ['Acceso a partidos abiertos', 'Badge de iniciación'],
  },
  {
    name: 'Plata',
    range: '40 – 59',
    icon: '🥈',
    color: 'from-slate-500 to-slate-400',
    glow: 'rgba(100,116,139,0.4)',
    textColor: '#64748b',
    desc: 'Ya controlas. El nivel empieza a estar en tu cabeza.',
    perks: ['Partidos por nivel validado', 'Stats básicas de juego'],
  },
  {
    name: 'Oro',
    range: '60 – 74',
    icon: '🥇',
    color: 'from-yellow-500 to-amber-400',
    glow: 'rgba(234,179,8,0.5)',
    textColor: '#ca8a04',
    desc: 'Jugador consolidado. La comunidad te conoce y respeta.',
    perks: ['Ranking visible en el club', 'Acceso a ligas avanzadas'],
    current: true,
  },
  {
    name: 'Diamante',
    range: '75 – 89',
    icon: '💎',
    color: 'from-brand-500 to-electric-500',
    glow: 'rgba(47,95,255,0.5)',
    textColor: '#2f5fff',
    desc: 'Élite local. Buscas rivales a tu altura, pocos los hay.',
    perks: ['Featured en el club', 'Acceso a torneos premium'],
  },
  {
    name: 'Élite MVP',
    range: '90 – 100',
    icon: '👑',
    color: 'from-purple-600 to-pink-500',
    glow: 'rgba(147,51,234,0.5)',
    textColor: '#9333ea',
    desc: 'Top 1%. El juego a este nivel es una religión.',
    perks: ['Badge exclusivo de Élite', 'Invitaciones a eventos top'],
  },
];

const pointSources = [
  { action: 'Ganar partido (vs igual nivel)', pts: '+10 a +20', icon: '🏆', color: 'text-court-500' },
  { action: 'Ganar partido (vs nivel superior)', pts: '+15 a +25', icon: '⚡', color: 'text-brand-500' },
  { action: 'Perder vs nivel superior', pts: '–0 a –3', icon: '📉', color: 'text-ink-400' },
  { action: 'Ser votado MVP del partido', pts: '+8 bonus', icon: '🌟', color: 'text-gold-500' },
  { action: 'Racha ganadora (3+ partidos)', pts: '+5 por victoria', icon: '🔥', color: 'text-coral-500' },
  { action: 'Ganar torneo (final)', pts: '+30', icon: '🏅', color: 'text-gold-500' },
  { action: 'Finalista torneo', pts: '+15', icon: '🎖️', color: 'text-ink-500' },
  { action: 'Conseguir nueva insignia', pts: '+5', icon: '🛡️', color: 'text-electric-500' },
];

const coinSources = [
  { action: 'Ganar partido', coins: '+20', icon: '🏆' },
  { action: 'Ser votado MVP', coins: '+50', icon: '👑' },
  { action: 'Registrar 3er tiempo', coins: '+10', icon: '🍻' },
  { action: 'Ganar torneo', coins: '+200', icon: '🥇' },
  { action: 'Conseguir insignia', coins: '+30', icon: '🛡️' },
  { action: 'Reclutar amigo', coins: '+100', icon: '👥' },
  { action: 'Racha de 5 victorias', coins: '+75', icon: '🔥' },
  { action: 'Completar perfil', coins: '+25', icon: '✅' },
];
---

<section id="ranking" class="relative py-28 overflow-hidden bg-night-950">
  <div class="absolute inset-0 grid-pattern"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 h-px w-2/3" style="background: linear-gradient(90deg, transparent, rgba(99,102,241,0.4), transparent)"></div>

  <!-- Glow orbs -->
  <div class="absolute top-20 left-20 h-96 w-96 rounded-full blur-3xl opacity-20" style="background: radial-gradient(circle, #6366f1, transparent)"></div>
  <div class="absolute bottom-20 right-20 h-64 w-64 rounded-full blur-3xl opacity-15" style="background: radial-gradient(circle, #f59e0b, transparent)"></div>

  <div class="container-x relative">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="badge badge-dark mb-4">Sistema de puntuación</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-white">
        Cada partido importa.<br/>
        <span class="text-gradient-gold">Tu nivel, probado en la pista.</span>
      </h2>
      <p class="mt-4 text-white/50 text-lg">
        MVP Rating basado en Elo adaptado al padel. La IA valida tu nivel real con datos de cada partido, no solo con victorias.
      </p>
    </div>

    <!-- Ranking tiers -->
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5 mb-16">
      {tiers.map(t => (
        <div class={`relative rounded-2xl border transition-all duration-300 hover:-translate-y-1 overflow-hidden ${t.current ? 'border-white/20' : 'border-white/8'}`}
             style={t.current ? `box-shadow: 0 0 0 1px rgba(255,255,255,0.15), 0 20px 60px -15px ${t.glow}` : `background: rgba(255,255,255,0.04)`}>
          {t.current && (
            <div class="absolute top-0 left-0 right-0 h-0.5" style={`background: linear-gradient(90deg, transparent, ${t.textColor}, transparent)`}></div>
          )}
          {t.current && (
            <div class="absolute top-3 right-3">
              <span class="text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full" style={`background: ${t.textColor}20; color: ${t.textColor}`}>Tú aquí</span>
            </div>
          )}

          <div class="p-5">
            <div class={`h-12 w-12 rounded-xl bg-gradient-to-br ${t.color} grid place-items-center text-xl shadow-lg mb-4`}
                 style={`box-shadow: 0 8px 24px -8px ${t.glow}`}>
              {t.icon}
            </div>
            <h3 class="font-display text-xl font-bold text-white">{t.name}</h3>
            <p class="text-xs font-bold mt-0.5" style={`color: ${t.textColor}`}>{t.range} pts</p>
            <p class="text-white/45 text-xs mt-3 leading-relaxed">{t.desc}</p>
            <ul class="mt-3 space-y-1.5">
              {t.perks.map(p => (
                <li class="flex items-center gap-2 text-white/60 text-[11px]">
                  <span class="h-1 w-1 rounded-full bg-white/40 shrink-0"></span>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Points system + Coins system -->
    <div class="grid lg:grid-cols-2 gap-6">
      <!-- MVP Rating points -->
      <div class="rounded-2xl border border-white/10 bg-white/4 p-7 backdrop-blur-sm">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-10 w-10 rounded-xl bg-brand-500/20 grid place-items-center text-xl">📊</div>
          <div>
            <h3 class="font-display text-lg font-bold text-white">MVP Rating</h3>
            <p class="text-white/40 text-xs">Sube o baja con cada partido (0–100)</p>
          </div>
        </div>
        <div class="space-y-2.5">
          {pointSources.map(p => (
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-2.5 text-sm text-white/60">
                <span>{p.icon}</span>
                <span>{p.action}</span>
              </div>
              <span class={`font-bold text-sm shrink-0 ${p.color}`}>{p.pts}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- MVP Coins -->
      <div class="rounded-2xl border border-white/10 bg-white/4 p-7 backdrop-blur-sm">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-10 w-10 rounded-xl bg-gold-500/20 grid place-items-center text-xl">🪙</div>
          <div>
            <h3 class="font-display text-lg font-bold text-white">MVP Coins</h3>
            <p class="text-white/40 text-xs">Moneda social para canjear en clubs aliados</p>
          </div>
        </div>
        <div class="space-y-2.5">
          {coinSources.map(c => (
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-2.5 text-sm text-white/60">
                <span>{c.icon}</span>
                <span>{c.action}</span>
              </div>
              <span class="font-bold text-sm text-gold-400 shrink-0">{c.coins}</span>
            </div>
          ))}
        </div>
        <div class="mt-5 rounded-xl bg-gold-500/10 border border-gold-500/20 px-4 py-3">
          <p class="text-gold-300 text-xs">💡 Las MVP Coins se canjean por descuentos, material y acceso VIP a eventos en clubs aliados.</p>
        </div>
      </div>
    </div>
  </div>
</section>
