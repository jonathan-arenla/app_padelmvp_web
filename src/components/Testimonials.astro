---
const reviews = [
  {
    headline: '¡La mejor app de pádel!',
    name: 'Carlos A.',
    avatar: 'C',
    color: '#1040f5',
    text: '"Con Padel MVP por fin tengo un ranking real. Cada partido cuenta, y el muro del club es adictivo. Mis compis y yo lo usamos después de cada partido."',
  },
  {
    headline: '¡Una pasada!',
    name: 'Marta B.',
    avatar: 'M',
    color: '#f97316',
    text: '"Ha sido el mejor descubrimiento del año. El sistema de ELO es muy justo y las insignias molan muchísimo. El 3er tiempo se ha convertido en un ritual."',
  },
  {
    headline: '¡Rápida y muy completa!',
    name: 'Iñigo P.',
    avatar: 'I',
    color: '#9b6bff',
    text: '"Una app para registrar partidos, gestionar ligas del club y presumir de carta FIFA con tus amigos. Imprescindible para cualquier padelero."',
  },
];
---
<section id="testimonios" class="bg-cream py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-14 text-center">
      <p class="section-label">Opiniones</p>
      <h2 class="font-display text-4xl leading-none tracking-wide text-night-900 sm:text-5xl mt-3">
        LO QUE DICEN<br /><span class="text-brand-600">LOS JUGADORES</span>
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {reviews.map(r => (
        <div class="rounded-3xl bg-white p-8 shadow-card border border-gray-100">
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {Array(5).fill(null).map(() => <span class="text-orange-400">★</span>)}
          </div>

          <p class="font-bold text-night-900">{r.headline}</p>

          <!-- Avatar + name -->
          <div class="my-5 flex items-center gap-3">
            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white"
              style={`background: ${r.color}`}
            >
              {r.avatar}
            </div>
            <p class="text-sm font-semibold text-night-900">{r.name}</p>
          </div>

          <p class="text-sm leading-relaxed text-gray-500">{r.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
