---
const items = [
  {
    n: 'Andrés López',
    r: 'Capitán equipo M3 · Madrid',
    q: 'El sistema de insignias nos ha cambiado la forma de competir. El Muro, el Cañonero... ya no se discute quién jugó mejor. Lo dice la app.',
    stars: 5,
    badge: '🏆 Oro',
    avatar: 'A',
    grad: 'from-brand-500 to-electric-600',
  },
  {
    n: 'Sara Méndez',
    r: 'Socia Club Padel Norte · BCN',
    q: 'Por fin una app que entiende que el padel es comunidad. El 3er tiempo organizado es lo mejor que me ha pasado jugando a padel.',
    stars: 5,
    badge: '💎 Diamante',
    avatar: 'S',
    grad: 'from-coral-500 to-coral-400',
  },
  {
    n: 'Roberto J.',
    r: 'Director · Padel Indoor BCN',
    q: 'Pasamos de Playtomic a PadelMVP Manager. Mismas features, mitad de coste, soporte de verdad. Y los socios están mucho más enganchados.',
    stars: 5,
    badge: '🏟️ Club Pro',
    avatar: 'R',
    grad: 'from-gold-500 to-amber-400',
  },
];
---

<section class="relative py-20 bg-surface">
  <div class="container-x">
    <div class="text-center mb-12">
      <p class="badge badge-brand mb-3">Testimonios</p>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-ink-900">Lo que dice la comunidad.</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {items.map(i => (
        <figure class="card p-7 card-hover">
          <div class="flex text-gold-400 mb-4 gap-0.5 text-sm">
            {'★'.repeat(i.stars)}
          </div>
          <blockquote class="text-ink-700 leading-relaxed">"{i.q}"</blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <div class={`h-11 w-11 rounded-full bg-gradient-to-br ${i.grad} grid place-items-center font-bold text-white shrink-0`}>
              {i.avatar}
            </div>
            <div>
              <p class="font-semibold text-sm text-ink-900">{i.n}</p>
              <p class="text-xs text-ink-400">{i.r}</p>
            </div>
            <span class="ml-auto text-xs font-bold text-ink-500 shrink-0">{i.badge}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
