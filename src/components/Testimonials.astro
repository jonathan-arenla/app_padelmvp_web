---
const items = [
  { n: 'Andrés López', r: 'Capitán equipo M3 · Madrid', q: 'El sistema MVP nos ha cambiado la forma de competir. Y reservar el bar para el tercer tiempo en 2 toques no tiene precio.' },
  { n: 'Sara Méndez', r: 'Socia Club Padel Norte', q: 'Por fin una app que entiende que el padel es comunidad. El matchmaking por nivel real es una pasada.' },
  { n: 'Roberto J.', r: 'Director · Padel Indoor BCN', q: 'Pasamos de Playtomic a PadelMVP Manager. Mismas features, mitad de coste, soporte humano. Y nuestros socios encantados.' },
];
---
<section class="py-24 bg-cream">
  <div class="container-x">
    <div class="grid md:grid-cols-3 gap-6">
      {items.map(i => (
        <figure class="bg-white rounded-3xl p-7 ring-1 ring-ink-900/5 shadow-card">
          <div class="flex text-coral-500 mb-3">★★★★★</div>
          <blockquote class="text-ink-900 text-lg leading-relaxed">"{i.q}"</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-gradient-to-br from-brand-500 to-coral-500 grid place-items-center font-bold text-white">{i.n[0]}</div>
            <div>
              <p class="font-semibold text-sm text-ink-900">{i.n}</p>
              <p class="text-xs text-ink-500">{i.r}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
